{
  "$comment": "Antigravity hooks projection (sprint_agy). Maps Antigravity tool lifecycle events to the unified antigravity-pretool-guard and antigravity-stop-hook adapters.",
  "pipeline-core": {
    "enabled": true,
    "PreToolUse": [
      {
        "matcher": "run_command|write_to_file|replace_file_content|invoke_subagent",
        "hooks": [
          {
            "type": "command",
            "command": "node \\"../plugins/pipeline-core/hooks/antigravity-pretool-guard.mjs\\"",
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \\"../plugins/pipeline-core/hooks/antigravity-stop-hook.mjs\\"",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
