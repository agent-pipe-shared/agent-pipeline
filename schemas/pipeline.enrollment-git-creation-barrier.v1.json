{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pipeline.enrollment-git-creation-barrier.v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "root",
    "rootIdentity",
    "plan",
    "phase",
    "gitIdentity"
  ],
  "properties": {
    "schema": {
      "const": "pipeline.enrollment-git-creation-barrier.v1"
    },
    "root": {
      "type": "string"
    },
    "rootIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dev",
        "ino"
      ],
      "properties": {
        "dev": {
          "type": "string",
          "pattern": "^[0-9]+$"
        },
        "ino": {
          "type": "string",
          "pattern": "^[0-9]+$"
        }
      }
    },
    "plan": {
      "$ref": "pipeline.enrollment-git-creation-plan.v1.json"
    },
    "phase": {
      "enum": [
        "requested",
        "created",
        "retired"
      ]
    },
    "gitIdentity": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "dev",
            "ino"
          ],
          "properties": {
            "dev": {
              "type": "string",
              "pattern": "^[0-9]+$"
            },
            "ino": {
              "type": "string",
              "pattern": "^[0-9]+$"
            }
          }
        },
        {
          "type": "null"
        }
      ]
    }
  }
}
