{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pipeline.architecture-decision.v2",
  "title": "Explicit module-scoped Architecture Decision Record",
  "description": "An exact OKF module-applicability record for an ADR. An accepted record is effective only after its Markdown digest and every named module ID are validated against the physical map. Historical v1 sidecars remain readable without inferred module authority.",
  "type": "object",
  "required": [
    "schema",
    "id",
    "title",
    "status",
    "digest",
    "scope",
    "moduleIds",
    "date"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": "pipeline.architecture-decision.v2" },
    "id": { "type": "string", "pattern": "^[A-Za-z0-9._-]+$" },
    "title": { "type": "string", "minLength": 1 },
    "status": { "enum": ["proposed", "accepted", "superseded", "waived"] },
    "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "scope": { "const": "module" },
    "moduleIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,79}$" }
    },
    "date": { "type": "string", "format": "date" },
    "supersedes": { "type": "string", "pattern": "^[A-Za-z0-9._-]+$" },
    "exception": {
      "type": "object",
      "required": ["authority", "rationale", "scope", "expiry"],
      "additionalProperties": false,
      "properties": {
        "authority": { "type": "string", "minLength": 1 },
        "rationale": { "type": "string", "minLength": 1 },
        "scope": { "type": "string", "minLength": 1 },
        "expiry": { "type": "string", "format": "date" }
      }
    }
  }
}
