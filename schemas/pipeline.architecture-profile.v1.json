{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pipeline.architecture-profile.v1",
  "title": "Architecture Profile (pipeline.architecture-profile.v1)",
  "description": "Schema for architecture profiles defining agent-first properties and navigation map bundle bindings (WP-D2, Issue #104, AC-8, AC-22, AC-23, Spec §7.2, Doctrine §2).",
  "type": "object",
  "required": [
    "schema",
    "profileId",
    "source",
    "revision",
    "mapBundlePath",
    "properties"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "type": "string",
      "enum": [
        "pipeline.architecture-profile.v1"
      ]
    },
    "profileId": {
      "type": "string"
    },
    "source": {
      "type": "string",
      "enum": [
        "inherited-agent-first",
        "accepted-custom"
      ]
    },
    "revision": {
      "type": "integer"
    },
    "digest": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "mapBundlePath": {
      "type": "string"
    },
    "specDigest": {
      "type": "string"
    },
    "properties": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "propertyId",
          "class",
          "measurementStatus",
          "blocking"
        ],
        "additionalProperties": false,
        "properties": {
          "propertyId": {
            "type": "string",
            "enum": [
              "context-locality",
              "contract-sufficiency",
              "change-locality",
              "dependency-legibility",
              "authority-effect-locality",
              "verification-locality",
              "session-reentry-stability",
              "parallel-work-safety",
              "refactorability-without-churn"
            ]
          },
          "class": {
            "type": [
              "integer",
              "string"
            ]
          },
          "form": {
            "type": "string",
            "enum": [
              "declaration",
              "signal",
              "check"
            ]
          },
          "declaration": {
            "type": [
              "string",
              "boolean",
              "object"
            ]
          },
          "signal": {
            "type": [
              "string",
              "boolean",
              "object"
            ]
          },
          "check": {
            "type": [
              "string",
              "boolean",
              "object"
            ]
          },
          "measurementStatus": {
            "type": "string",
            "enum": [
              "measured",
              "estimated",
              "unavailable",
              "unknown"
            ]
          },
          "blocking": {
            "type": "string",
            "enum": [
              "advisory-first",
              "blocking",
              "report-only"
            ]
          },
          "description": {
            "type": "string"
          }
        }
      }
    }
  }
}
