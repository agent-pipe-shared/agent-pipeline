{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pipeline.enrollment-git-creation-plan.v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "root",
    "rootIdentity",
    "runner",
    "gitVersion",
    "scopeSha256",
    "retained",
    "entries",
    "planSha256"
  ],
  "properties": {
    "schema": {
      "const": "pipeline.enrollment-git-creation-plan.v1"
    },
    "root": {
      "type": "string"
    },
    "rootIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dev",
        "ino"
      ],
      "properties": {
        "dev": {
          "type": "string",
          "pattern": "^[0-9]+$"
        },
        "ino": {
          "type": "string",
          "pattern": "^[0-9]+$"
        }
      }
    },
    "runner": {
      "enum": [
        "claude",
        "codex",
        "antigravity"
      ]
    },
    "gitVersion": {
      "type": "string"
    },
    "scopeSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "retained": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "status",
          "identity",
          "sha256",
          "bytesBase64"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "status": {
            "enum": [
              "present",
              "absent"
            ]
          },
          "identity": {
            "anyOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "dev",
                  "ino"
                ],
                "properties": {
                  "dev": {
                    "type": "string",
                    "pattern": "^[0-9]+$"
                  },
                  "ino": {
                    "type": "string",
                    "pattern": "^[0-9]+$"
                  }
                }
              },
              {
                "type": "null"
              }
            ]
          },
          "sha256": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "bytesBase64": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      }
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "maxItems": 4096
    },
    "planSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
