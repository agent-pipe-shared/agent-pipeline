{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pipeline.invocation-request.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "invocationId", "subject", "route", "duty", "sandboxDispositionSha256", "command", "inputDigests", "timeoutMs", "allowedOutputs", "privacyClass", "requestSha256"],
  "properties": {
    "schema": { "const": "pipeline.invocation-request.v1" },
    "invocationId": { "type": "string", "minLength": 1, "maxLength": 256 },
    "subject": { "type": "object", "additionalProperties": false, "required": ["kind", "sha256"], "properties": { "kind": { "type": "string", "minLength": 1, "maxLength": 64 }, "sha256": { "$ref": "#/$defs/sha256" } } },
    "route": { "type": "object", "additionalProperties": false, "required": ["runner", "adapterId", "adapterVersion", "requestedModel"], "properties": { "runner": { "type": "string", "minLength": 1, "maxLength": 128 }, "adapterId": { "type": "string", "minLength": 1, "maxLength": 128 }, "adapterVersion": { "type": "string", "minLength": 1, "maxLength": 128 }, "requestedModel": { "type": "string", "minLength": 1, "maxLength": 128 } } },
    "duty": { "type": "string", "minLength": 1, "maxLength": 64 }, "sandboxDispositionSha256": { "$ref": "#/$defs/sha256" },
    "command": { "type": "object", "additionalProperties": false, "required": ["contractId", "executableSha256", "arguments"], "properties": { "contractId": { "type": "string", "minLength": 1, "maxLength": 128 }, "executableSha256": { "$ref": "#/$defs/sha256" }, "arguments": { "type": "array", "maxItems": 256, "items": { "type": "object", "additionalProperties": false, "required": ["type", "value"], "properties": { "type": { "enum": ["literal", "digest-ref"] }, "value": { "type": "string", "minLength": 1, "maxLength": 512 } } } } } },
    "inputDigests": { "type": "array", "maxItems": 256, "items": { "$ref": "#/$defs/sha256" } }, "timeoutMs": { "type": "integer", "minimum": 1000, "maximum": 3600000 }, "allowedOutputs": { "type": "array", "minItems": 1, "maxItems": 256, "items": { "enum": ["result", "receipt", "metrics"] } }, "privacyClass": { "enum": ["public", "restricted", "private"] }, "requestSha256": { "$ref": "#/$defs/sha256" }
  },
  "$defs": { "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" } }
}
