 export const APP_SERVER_SCRIPT = fileURLToPath(new URL("../../scripts/codex-app-server-health.mjs", import.meta.url));

 export const START_PREFLIGHT_SCRIPT = fileURLToPath(new URL("../../scripts/pipeline-start-preflight.mjs", import.meta.url));
+
+// win32 spellings of the same path (separator and case) compare equal; dot segments
+// and any other path still miss, so this never widens the sanctioned script set.
+export function sameSanctionedScriptPath(spelled, sanctioned, platform = process.platform) {
+  if (typeof spelled !== "string" || typeof sanctioned !== "string") return false;
+  if (spelled === sanctioned) return true;
+  if (platform !== "win32") return false;
+  const fold = (value) => value.replaceAll("/", "\\").toLowerCase();
+  return fold(spelled) === fold(sanctioned);
+}

 // A stale pipeline-owned hook must be able to invoke only its own exact updater.
