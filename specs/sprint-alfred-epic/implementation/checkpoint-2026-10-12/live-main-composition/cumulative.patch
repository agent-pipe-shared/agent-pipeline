+      const r=spawnSync("git",args,{cwd:repoRoot,timeout:10000,maxBuffer:16*1024*1024,windowsHide:true});
+      if(r.error || r.signal || r.status!==0 || !Buffer.isBuffer(r.stdout)) throw new Error("Git unavailable");
