+  const match=/^PRESENT:([1-9][0-9]{0,18})$/u.exec(text);
+  if(match===null||BigInt(match[1])>MAX_TICKS)return unavailable('native-output-malformed');
+  return {status:'present',pid:input.pid,processStart:`win32-${match[1]}`};
+}
