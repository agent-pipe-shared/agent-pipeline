+assert.equal(cases.length,3);
+registerTestCaseCompletion({cases,fd:Number(process.env.PIPELINE_VERIFY_CASE_COMPLETION_FD??3),maxBytes:Number(process.env.PIPELINE_VERIFY_CASE_COMPLETION_MAX_BYTES??65536)});
