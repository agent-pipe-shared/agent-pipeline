+// A consumer that closes a feature has its Spec folder committed: the close reads the candidate commit (Spec addenda, lapsed Critic
+// findings, maintenance deliveries) and the feature's range from the first commit touching specs/<feature> (ADR-0096). An unborn HEAD
+// or an uncommitted Spec folder fails as CLOSE-GIT or CLOSE-GATE-CHANGE-UNREADABLE before the gate a case means to reach.
+function commitSpecFolder(dir) {
+  const git = (...args) => execFileSync("git", ["-C", dir, ...args], { stdio: "ignore" });
+  git("add", "--", "specs/feature");
+  git("-c", "commit.gpgsign=false", "commit", "-q", "--no-verify", "-m", "fixture: approved Spec folder");
+}
 
