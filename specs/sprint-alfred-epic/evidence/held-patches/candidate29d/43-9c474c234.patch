+  if (approval === null) {
+    console.error(["PO APPROVAL OF A VERIFY COMMAND REPLACEMENT -- one signature covers both calibration files:",
+      `  now:   ${subject.previousCommand}`, `  after: ${subject.verifyCommand}`,
