+    || canonicalJson(readJson(join(packetDir, "claim.json"), "CPP-CLAIM-READ")) !== canonicalJson(claim)
+    || canonicalJson(readJson(join(packetDir, "result.json"), "CPP-RESULT")) !== canonicalJson(resultRecord)) {
