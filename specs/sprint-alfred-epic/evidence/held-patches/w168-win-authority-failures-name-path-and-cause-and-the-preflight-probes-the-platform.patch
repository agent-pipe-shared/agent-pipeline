+    extra = String(describe({ reason, platform, projectRoot: resolve(rootDir), pluginRoot: resolve(dirname(fileURLToPath(import.meta.url)), ".."), privateRoot: join(resolve(rootDir), ".git", "agent-pipeline") }) ?? "").trim();
