+
+// C31-B10 (L19, AC-112): a worktree-isolated dispatch starts from refs/remotes/origin/HEAD, not from HEAD. The preflight says so,
+// read-only, only when that ref exists and points at another commit than HEAD. Absent ref, equal commit or any git fault: nothing.
+function buildOriginHeadFixture({ originHead }) {
+  const root = realpathSync(mkdtempSync(join(tmpdir(), "c31-b10-origin-head-")));
+  const git = (args) => execFileSync("git", args, { cwd: root, encoding: "utf8", stdio: ["ignore", "pipe", "pipe"] }).trim();
+  git(["init", "--quiet", "--initial-branch=main"]);
+  git(["config", "user.email", "fixture@example.invalid"]);
+  git(["config", "user.name", "fixture"]);
+  git(["commit", "--quiet", "--allow-empty", "-m", "first"]);
+  const older = git(["rev-parse", "HEAD"]);
+  git(["commit", "--quiet", "--allow-empty", "-m", "second"]);
+  const head = git(["rev-parse", "HEAD"]);
+  if (originHead !== "absent") {
+    git(["remote", "add", "origin", "https://example.invalid/fixture.git"]);
+    git(["update-ref", "refs/remotes/origin/main", originHead === "stale" ? older : head]);
+    git(["symbolic-ref", "refs/remotes/origin/HEAD", "refs/remotes/origin/main"]);
+  }
+  return { root, git, older, head };
+}
+
+test("C31-B10: a stale refs/remotes/origin/HEAD yields one read-only notice naming the ref, the worktree start and the repair", () => {
+  const { root, git, older, head } = buildOriginHeadFixture({ originHead: "stale" });
+  try {
+    const before = git(["for-each-ref", "--format=%(refname) %(objectname)"]);
+    const notice = preflightModule.observeOriginHeadNotice({ rootDir: root });
+    assert.equal(typeof notice, "string");
+    assert.match(notice, /refs\/remotes\/origin\/HEAD/u);
+    assert.ok(notice.includes(older.slice(0, 7)) && notice.includes(head.slice(0, 7)), notice);
+    assert.match(notice, /worktree-isolated dispatches start from (?:it|that ref)/u);
+    assert.ok(notice.includes("git symbolic-ref refs/remotes/origin/HEAD refs/remotes/origin/<branch>"), notice);
+    assert.ok(notice.includes("git remote set-head origin <branch>"), notice);
+    assert.ok(Buffer.byteLength(notice) <= 600, `one short sentence, ${Buffer.byteLength(notice)} bytes`);
+    assert.equal(git(["for-each-ref", "--format=%(refname) %(objectname)"]), before, "detection never changes a ref");
+  } finally { rmSync(root, { recursive: true, force: true }); }
+});
+
+test("C31-B10: origin/HEAD equal to HEAD, no origin at all, a non-git directory and a git fault print no notice", () => {
+  const equal = buildOriginHeadFixture({ originHead: "equal" });
+  const absent = buildOriginHeadFixture({ originHead: "absent" });
+  const plain = mkdtempSync(join(tmpdir(), "c31-b10-no-git-"));
+  try {
+    assert.equal(preflightModule.observeOriginHeadNotice({ rootDir: equal.root }), null);
+    assert.equal(preflightModule.observeOriginHeadNotice({ rootDir: absent.root }), null);
+    assert.equal(preflightModule.observeOriginHeadNotice({ rootDir: plain }), null);
+    const stale = buildOriginHeadFixture({ originHead: "stale" });
+    try {
+      assert.equal(preflightModule.observeOriginHeadNotice({ rootDir: stale.root, run: () => null }), null);
+      assert.equal(preflightModule.observeOriginHeadNotice({ rootDir: stale.root, run: () => { throw new Error("git unavailable"); } }), null);
+    } finally { rmSync(stale.root, { recursive: true, force: true }); }
+  } finally {
+    rmSync(equal.root, { recursive: true, force: true });
+    rmSync(absent.root, { recursive: true, force: true });
+    rmSync(plain, { recursive: true, force: true });
+  }
+});
+
+test("C31-B10: the printed preflight line carries the notice only for a stale origin/HEAD, within its budget, and the status never changes", () => {
+  const stale = buildOriginHeadFixture({ originHead: "stale" });
+  const equal = buildOriginHeadFixture({ originHead: "equal" });
+  const absent = buildOriginHeadFixture({ originHead: "absent" });
+  try {
+    const withNotice = runPreflightProcess({}, [], { cwd: stale.root });
+    const equalRun = runPreflightProcess({}, [], { cwd: equal.root });
+    const absentRun = runPreflightProcess({}, [], { cwd: absent.root });
+    assert.equal(typeof withNotice.line.originHeadNotice, "string");
+    assert.match(withNotice.line.originHeadNotice, /refs\/remotes\/origin\/HEAD/u);
+    assert.equal(Object.hasOwn(equalRun.line, "originHeadNotice"), false);
+    assert.equal(Object.hasOwn(absentRun.line, "originHeadNotice"), false);
+    assert.equal(withNotice.line.status, equalRun.line.status, "the notice changes no status");
+    assert.equal(withNotice.line.status, absentRun.line.status);
+    assert.equal(withNotice.line.printedPayload.withinBudget, true);
+  } finally {
+    for (const fixture of [stale, equal, absent]) rmSync(fixture.root, { recursive: true, force: true });
+  }
+});
