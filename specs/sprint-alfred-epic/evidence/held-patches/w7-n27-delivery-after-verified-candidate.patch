+    ["a remote that is not configured", { remote: "nowhere" }, "PTP-REMOTE-NOT-A-NAME"],
+    ["an option-shaped remote", { remote: "--upload-pack=x" }, "PTP-REMOTE-NOT-A-NAME"],
