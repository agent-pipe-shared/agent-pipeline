+    assert.deepEqual(active().sort(), [running, foreign].sort(), "a live owner's descriptor and one without an owner-route record stay");
+  } finally {
+    const gone = new Promise((resolve) => alive.once("exit", resolve));
+    alive.kill("SIGKILL");
+    await gone;
+  }
+});
