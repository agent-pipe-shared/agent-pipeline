+    dead.kill("SIGKILL");
+    await gone;
+    const stale = leftover("a", deadRecord);
+    const running = leftover("b", observeNativePlatformProcess(alive.pid));
+    const foreign = `controller-${"c".repeat(24)}`;
+    startSessionDescriptor(p.root, { sessionId: foreign });
