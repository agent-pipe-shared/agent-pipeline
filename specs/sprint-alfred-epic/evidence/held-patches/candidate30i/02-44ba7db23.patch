+// ---- C30I-S1B: every shipped agent is marked subagent-only in the runner view (AC-108) -------------------------------------------
+
+const PINNED_KEYS = ['mainAgent: false', 'subagent: true', 'commandExecutionPolicy: sandbox', 'inheritCustomizations: true'];
+const SHIPPED_AGENTS = ['afk-claude-worker', 'consult-advisor', 'critic', 'goldfish-deep', 'goldfish-implementor', 'goldfish-mechanic', 'plan-verifier', 'readiness-reviewer'];
+const SHIPPED_AGENT_DIR = join(import.meta.dirname, '..', '..', 'agents');
+
+test('the runner view pins mainAgent false, subagent true, sandbox and inheritCustomizations in this order just before the closing line', () => {
+  const out = snap.transformAgyRunnerAgent('agents/x.md', Buffer.from('---\nname: x\nmodel: sonnet\n---\nbody\n')).toString();
+  assert.equal(out, `---\nname: x\nmodel: flash\n${PINNED_KEYS.join('\n')}\n---\nbody\n`);
+});
+
+test('all eight shipped agent files carry the four keys in order, keep their model and tools rewrites, and the Claude sources stay unchanged', () => {
+  assert.deepEqual(readdirSync(SHIPPED_AGENT_DIR).filter((name) => name.endsWith('.md')).map((name) => name.slice(0, -3)).sort(), SHIPPED_AGENTS);
+  for (const name of SHIPPED_AGENTS) {
+    const source = readFileSync(join(SHIPPED_AGENT_DIR, `${name}.md`));
+    const before = Buffer.from(source);
+    const lines = snap.transformAgyRunnerAgent(`agents/${name}.md`, source).toString().split('\n');
+    const close = lines.indexOf('---', 1);
+    assert.deepEqual(lines.slice(close - 4, close), PINNED_KEYS, `${name}: four keys in order just before the closing line`);
+    const front = lines.slice(1, close - 4).join('\n');
+    assert.doesNotMatch(front, /^model: (sonnet|haiku|opus)$/m, `${name}: model rewritten`);
+    assert.doesNotMatch(front, /^tools:.*\b(Read|Write|Edit|Bash|Grep|Glob)\b/m, `${name}: tools rewritten`);
+    assert.equal(/^inheritMcp:/m.test(lines.join('\n')), false, `${name}: inheritMcp untouched`);
+    assert.ok(source.equals(before), `${name}: the source bytes are unchanged`);
+    assert.doesNotMatch(source.toString(), /^(mainAgent|subagent|commandExecutionPolicy|inheritCustomizations):/m, `${name}: the Claude source carries none of the keys`);
+  }
+});
+
+test('a CRLF agent file stays CRLF with the four keys, a file without frontmatter is returned unchanged', () => {
+  const crlf = snap.transformAgyRunnerAgent('agents/x.md', Buffer.from('---\r\nname: x\r\nmodel: haiku\r\n---\r\nbody\r\n')).toString();
+  assert.equal(crlf, `---\r\nname: x\r\nmodel: flash\r\n${PINNED_KEYS.join('\r\n')}\r\n---\r\nbody\r\n`);
+  assert.equal(crlf.replace(/\r\n/g, '').includes('\n'), false, 'no bare LF appears');
+  const plain = Buffer.from('no frontmatter\nmodel: sonnet\n');
+  assert.equal(snap.transformAgyRunnerAgent('agents/x.md', plain), plain);
+  const unclosed = Buffer.from('---\nname: x\nbody\n');
+  assert.equal(snap.transformAgyRunnerAgent('agents/x.md', unclosed), unclosed);
+});
+
+test('a source frontmatter that already carries one of the four keys is refused AGV-AGENT-KEY-CONFLICT, and the output is not transformed twice', () => {
