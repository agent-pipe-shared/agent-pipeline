+  }
+  const once = snap.transformAgyRunnerAgent('agents/x.md', Buffer.from('---\nname: x\nmodel: opus\n---\nbody\n'));
+  assert.throws(() => snap.transformAgyRunnerAgent('agents/x.md', once), { code: 'AGV-AGENT-KEY-CONFLICT' }, 'the view is never an input of the transform');
+  const again = snap.transformAgyRunnerAgent('agents/x.md', Buffer.from('---\nname: x\nmodel: opus\n---\nbody\n'));
+  assert.ok(again.equals(once), 'the same source always gives the same bytes');
+  const body = Buffer.from('---\nname: x\n---\nmainAgent: true in the body is no frontmatter key\n');
