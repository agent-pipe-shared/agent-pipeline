-assert.equal(cases.length, 44, "the complete dispatch-record writer corpus must be registered before execution begins");
+// C18-1E (AC-108): the attempt-terminal binding accepts the original parent and, only with the typed movedHead evidence, a descendant parent.
+check("the attempt-terminal parent binding accepts the original parent and a typed moved-HEAD descendant, and refuses every other lineage", () => {
+  const root = mkdtempSync(join(tmpdir(), "dispatch-record-moved-"));
+  try {
+    const git = (...args) => execFileSync("git", ["-c", "user.name=t", "-c", "user.email=t@example.invalid", "-C", root, ...args], { encoding: "utf8" }).trim();
+    git("init", "-q");
+    writeFileSync(join(root, "a.txt"), "a\n"); git("add", "a.txt"); git("commit", "-qm", "base");
+    const candidate = git("rev-parse", "HEAD");
+    writeFileSync(join(root, "b.txt"), "b\n"); git("add", "b.txt"); git("commit", "-qm", "sibling");
+    const sibling = git("rev-parse", "HEAD");
+    git("checkout", "-q", "--detach", candidate);
+    writeFileSync(join(root, "c.txt"), "c\n"); git("add", "c.txt"); git("commit", "-qm", "unrelated branch");
+    const other = git("rev-parse", "HEAD");
+    const bound = writerModule.nativeAttemptTerminalParentBound;
+    assert.equal(typeof bound, "function");
+    const binding = { candidateCommit: candidate };
+    const v1 = { schema: "pipeline.native-goldfish-host-observation.v1" };
+    assert.equal(bound({ receipt: { ...v1, parent: candidate }, binding, root }), true, "original lineage");
+    assert.equal(bound({ receipt: { ...v1, parent: sibling }, binding, root }), false, "descendant parent without evidence");
+    const mh = { admittedHead: sibling, baselineCommit: candidate };
+    assert.equal(bound({ receipt: { ...v1, parent: sibling, movedHead: mh }, binding, root }), true, "typed descendant");
+    assert.equal(bound({ receipt: { ...v1, parent: sibling, movedHead: { ...mh, admittedHead: candidate } }, binding, root }), false, "admitted head differs from parent");
+    assert.equal(bound({ receipt: { ...v1, parent: sibling, movedHead: { ...mh, baselineCommit: sibling } }, binding, root }), false, "baseline is not the briefing candidate");
+    assert.equal(bound({ receipt: { ...v1, parent: sibling, movedHead: { admittedHead: sibling } }, binding, root }), false, "incomplete evidence");
+    assert.equal(bound({ receipt: { ...v1, parent: sibling, movedHead: { ...mh, extra: 1 } }, binding, root }), false, "extra evidence key");
+    assert.equal(bound({ receipt: { ...v1, parent: other, movedHead: { admittedHead: other, baselineCommit: candidate } }, binding, root }), true, "a sibling-branch commit on the candidate is a descendant");
+    const orphan = git("commit-tree", "-m", "orphan", `${candidate}^{tree}`);
+    assert.equal(bound({ receipt: { ...v1, parent: orphan, movedHead: { admittedHead: orphan, baselineCommit: candidate } }, binding, root }), false, "not a descendant of the candidate");
+  } finally { rmSync(root, { recursive: true, force: true }); }
+});
+
+assert.equal(cases.length, 45, "the complete dispatch-record writer corpus must be registered before execution begins");
 const completionFd = process.env.PIPELINE_VERIFY_CASE_COMPLETION_FD === undefined
   ? openSync(devNull, "w")
   : Number(process.env.PIPELINE_VERIFY_CASE_COMPLETION_FD);
