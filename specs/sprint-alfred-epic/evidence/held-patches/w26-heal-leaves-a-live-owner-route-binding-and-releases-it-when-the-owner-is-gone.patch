+test("D231 owner route (E): heal leaves the binding of an owner whose recorded process is still alive and releases it once that process is gone", { skip: process.platform === "win32" }, async () => {
+  const p = ownerRouteProject("cor-heal-live");
+  const heal = () => spawnNode(ROUTINE_REPAIR_CLI, ["run", "heal", "--root", p.root, "--reason", "test heal"], { cwd: p.root });
+  const killed = ownerRun(p, ["continuity-result-bootstrap-plan"], { env: { PIPELINE_COR_TEST_ABORT_AFTER_BIND: "1" } });
+  assert.equal(killed.signal, "SIGKILL", `the seam killed the owner after the bind: ${killed.stderr}`);
+  const directory = join(p.repository.commonDir, "agent-pipeline", "run", "session-requesters", "invocations");
+  const records = readdirSync(directory).filter((name) => /^owner-route-[a-f0-9]{24}\.json$/u.test(name));
+  assert.equal(records.length, 1, "the killed call left exactly one owner-route invocation record");
+  const recordPath = join(directory, records[0]);
+  const record = JSON.parse(readFileSync(recordPath, "utf8"));
+  // Stand-in for a running owner: a real live process, recorded with the identity the liveness check observes for it.
+  const stand = spawn(process.execPath, ["-e", "setTimeout(() => {}, 60000)"], { stdio: "ignore" });
+  try {
+    await new Promise((resolve) => setTimeout(resolve, 200));
+    writeFileSync(recordPath, JSON.stringify({ ...record, process: observeNativePlatformProcess(stand.pid) }));
+    const held = heal();
+    assert.equal(held.status, 0, held.stdout + held.stderr);
+    const report = JSON.parse(held.stdout).ownerRoute;
+    assert.equal(report.status, "live", "a running owner is reported and left alone");
+    assert.notEqual(observeSessionCleanupState(p.root).sessionCleanup, null, "its binding is still held");
+    assert.equal(onboardingInFlight(p), 1, "and its member is still in flight");
+    assert.equal(envelopeOf(ownerRun(p, ["continuity-result-bootstrap-plan"])).code, "COR-BINDING-HELD", "the next call is still told to wait or heal");
+  } finally {
+    const gone = new Promise((resolve) => stand.once("exit", resolve));
+    stand.kill("SIGKILL");
+    await gone;
+  }
+  const released = heal();
+  assert.equal(released.status, 0, released.stdout + released.stderr);
+  assert.equal(JSON.parse(released.stdout).ownerRoute.status, "released", "once the recorded process is gone the same heal releases the binding");
+  assertReleased(p, "after the stand-in is gone");
+});
+
