+    const matches = result.stdout.split("\n").filter((line) => line !== "").map((line) => line.split("\t"))
+      .filter((fields) => fields.length === 2 && fields[1] === destination);
+    if (matches.length !== 1 || !REMOTE_OBJECT_ID_RE.test(matches[0][0])) return null;
+    return matches[0][0];
+  } catch { return null; }
