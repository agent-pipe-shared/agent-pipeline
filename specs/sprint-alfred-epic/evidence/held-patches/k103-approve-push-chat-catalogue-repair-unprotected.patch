+#!/usr/bin/env node
+// SPDX-License-Identifier: SUL-1.0
+/**
+ * K103 part D1 (PO decision 2026-10-23, tiles batch 7 rows 1 and 2; D74: every refusal needs a repair that can actually
+ * be run). `approve-push` under `gates.push_approval: chat` while the session-authority catalogue exists is refused by
+ * the State push producer route (a shell binds no requester). The refusal must name a concrete, runnable next step with
+ * its `--root` argument, and the command it names must not itself come back empty.
+ *
+ * Real git repository, real CLI entry (`run`), no injected dependencies; the repository, the machine plane (HOME) and the
+ * key directory live under os.tmpdir() / the native fixture parent.
+ */
+import assert from "node:assert/strict";
+import { spawnSync } from "node:child_process";
+import { mkdirSync, mkdtempSync, realpathSync, rmSync, writeFileSync } from "node:fs";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import test from "node:test";
+
+import { run } from "./pipeline-state.mjs";
+import { createGovernanceScopeController } from "../lib/governance-scope.mjs";
+import { createSessionAuthorityParticipantPorts } from "../lib/session-authority-observers.mjs";
+import { initializeSessionAuthorityRegistry } from "../lib/session-authority-registry.mjs";
+import { nativeContractFixtureParent, prepareApprovedItemCourseFixture } from "../lib/test-item-approved-course-fixture.mjs";
+import { inspectSignedDescriptorCustodyRepository } from "../lib/worktree-lifecycle.mjs";
+
+const roots = [];
+test.after(() => { for (const root of roots) rmSync(root, { recursive: true, force: true }); });
+
+function git(cwd, args) {
+  const result = spawnSync("git", args, { cwd, encoding: "utf8" });
+  if (result.error || result.status !== 0) throw new Error(`git ${args.join(" ")} failed: ${result.stderr}`);
+  return result.stdout.trim();
+}
+
+function captured(fn) {
+  const stdout = [];
+  const stderr = [];
+  const saved = { log: console.log, error: console.error };
+  console.log = (...args) => stdout.push(args.join(" "));
+  console.error = (...args) => stderr.push(args.join(" "));
+  let code;
+  try { code = fn(); } finally { Object.assign(console, saved); }
+  return { code, stdout: stdout.join("\n"), stderr: stderr.join("\n") };
+}
+
+/** A governed repository in chat push-approval mode with an initialized session-authority catalogue. */
+function buildChatFixture() {
+  const parent = nativeContractFixtureParent();
+  mkdirSync(parent, { recursive: true, mode: 0o700 });
+  const dir = mkdtempSync(join(parent, "k103-approve-push-chat-"));
+  roots.push(dir);
+  const home = mkdtempSync(join(tmpdir(), "k103-approve-push-chat-home-"));
+  roots.push(home);
+  mkdirSync(join(dir, "evidence"), { mode: 0o700 });
+  git(dir, ["init", "-q", "-b", "main"]);
+  for (const [name, value] of [["user.name", "Fixture"], ["user.email", "fixture@example.invalid"], ["commit.gpgsign", "false"]]) git(dir, ["config", name, value]);
+  writeFileSync(join(dir, "README.md"), "fixture\n");
+  writeFileSync(join(dir, ".gitignore"), "scratch/\nevidence/\n.claude/\n");
+  git(dir, ["add", "README.md", ".gitignore"]);
+  git(dir, ["commit", "-q", "-m", "init"]);
+  const controller = createGovernanceScopeController({ hostStateRoot: join(dir, "fixture-host") });
+  const plan = controller.planDecision({ rootDir: dir, decision: "enroll", by: "fixture explicit course" });
+  controller.applyDecision(plan, { activate: true, planSha256: plan.planSha256 });
+  prepareApprovedItemCourseFixture({ root: dir });
+  writeFileSync(join(dir, "pipeline.user.yaml"), 'schema: "pipeline.user.v1"\ngates:\n  push_approval: "chat"\n');
+  mkdirSync(join(home, ".agent-pipeline"), { recursive: true });
+  writeFileSync(join(home, ".agent-pipeline", "machine.json"), JSON.stringify({
+    schema: "pipeline.machine-plane.v1", poKeyDirectory: null, pushApprovalDefault: "chat",
+    routing: null, language: null, session: null, usage: null, updatedAt: "2026-10-22T00:00:00.000Z",
+  }));
+  git(dir, ["add", "pipeline.user.yaml"]);
+  git(dir, ["commit", "-q", "-m", "fixture policy"]);
+  const repository = inspectSignedDescriptorCustodyRepository(dir);
+  initializeSessionAuthorityRegistry({ repository }, createSessionAuthorityParticipantPorts({ repository }));
+  return { dir, home, argv: ["approve-push", "--by", "PO", "--remote", "origin", "--destination", "refs/heads/main"] };
+}
+
+function callApprove(fixture) {
+  const names = ["HOME", "USERPROFILE", "PIPELINE_PO_APPROVAL_DIRECTORY"];
+  const saved = Object.fromEntries(names.map((name) => [name, process.env[name]]));
+  process.env.HOME = fixture.home;
+  process.env.USERPROFILE = fixture.home;
+  delete process.env.PIPELINE_PO_APPROVAL_DIRECTORY;
+  try {
+    return captured(() => run(fixture.argv, { dir: fixture.dir }));
+  } finally {
+    for (const name of names) { if (saved[name] === undefined) delete process.env[name]; else process.env[name] = saved[name]; }
+  }
+}
+
+test("K103 D1: chat-mode approve-push with a catalogue is refused with a typed reason and a runnable repair, not a pointer to an inspect that finds nothing", () => {
+  const fixture = buildChatFixture();
+  const result = callApprove(fixture);
+  assert.equal(result.code, 2, `${result.stderr}`);
+  assert.equal(result.stdout, "", "a refused approval prints no success");
+  assert.match(result.stderr, /SDC-AUTHORITY-UNAVAILABLE: state-push-source-requester/, "the typed code and reason stay");
+  // Measured on this fixture: the inspect command the old text pointed at reports a healthy registry (status "inspected", every
+  // producer ok, drifted []) and its only `next` is an unrelated scratch-binding heal -- it does not clear this refusal.
+  const repair = spawnSync(process.execPath, [new URL("./session-authority-repair.mjs", import.meta.url).pathname, "inspect", "--root", fixture.dir], { encoding: "utf8" });
+  assert.equal(repair.status, 0);
+  assert.ok(!JSON.parse(repair.stdout).registry.producers.some((producer) => producer.drifted.length > 0 || producer.inFlight > 0), "the registry is healthy: inspect cannot be the repair");
+  // The refusal therefore names the cause and the step that can actually be run.
+  assert.match(result.stderr, /chat mode/i, "names the mode");
+  assert.match(result.stderr, /requester/i, "names the cause: no requester is bound by this shell");
+  assert.match(result.stderr, /gates\.push_approval/, "names the setting that selects the route");
+  assert.match(result.stderr, /signature/, "names the route that works while a catalogue exists");
+  assert.match(result.stderr, /docs\/push-release-flow\.md/, "points at the step-by-step flow");
+  assert.match(result.stderr, /approve-push --by <name> --remote <remote> --destination <ref> --proof-request <file> --proof-authority <file> --proof <file>/, "carries the concrete command shape");
+  assert.ok(result.stderr.includes(`session-authority-repair.mjs inspect --root ${fixture.dir}`), "the diagnostic command with its --root argument stays named");
+  assert.ok(!/names the cause and the command that clears it/.test(result.stderr), "the general sentence that is false for this reason is not repeated");
+});
