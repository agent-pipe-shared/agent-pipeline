+    "gemini-3.1-pro": { "input": 2.0, "cachedInput": 0.2, "output": 12.0, "note": "low confidence; listed for prompts up to 200K context" },
+    "gemini-3.1-flash-lite": { "input": 0.25, "cachedInput": 0.025, "output": 1.5, "note": "low confidence" }
+  }
+}
