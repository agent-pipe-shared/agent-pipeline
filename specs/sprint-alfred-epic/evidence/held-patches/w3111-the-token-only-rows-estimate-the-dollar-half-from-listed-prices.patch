+    "gpt-5-codex": { "input": 1.25, "cachedInput": null, "output": 10.0, "note": "low confidence; no cached-input price listed, cached tokens are priced at the input price (upper bound); API dollar list price, not ChatGPT credits" },
+    "gemini-3.8-flash": { "input": 1.5, "cachedInput": 0.15, "output": 7.5, "note": "low confidence; two conflicting listings exist, the higher one is used (PO decision 2026-11-19), the introductory 0.75 / 3.75 listing is not used" },
