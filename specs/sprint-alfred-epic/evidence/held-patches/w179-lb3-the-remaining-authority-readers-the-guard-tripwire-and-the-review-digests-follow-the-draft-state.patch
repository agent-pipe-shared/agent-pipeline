+    const refused = resolveCriticPreflightContext({ root: fx.root, specPath });
+    assert.equal(refused.ok, false);
+    assert.equal(refused.code, "C1O-SCOPE-BINDING");
+  } finally { rmSync(fx.root, { recursive: true, force: true }); }
+});
