+// Candidate 17 (intake 1m): a profile-drift block says in words that it is a repository state and names the renewal route.
+test("a blocking profile-drift outcome (class 9) names the adoption renewal in the refusal", () => {
+  const result = inspectArchitectureEntryReadiness({
+    rootDir: repoRoot,
+    planningSurface: { planPath: "specs/security-deps.md", paths: ["package.json"] },
+    deps: { readCheckpointArchitectureDebt: clearCheckpointDebt,
+      checkPlanningAdoptionDisposition: readyDisposition,
+      evaluateArchitectureFitness: () => ({
+        overallStatus: "blocked",
+        summary: { passCount: 9, findingCount: 1, exceptedCount: 0, unavailableCount: 0, unsupportedCount: 0, unknownCount: 0, totalClasses: 10 },
+        outcomes: [
+          ...Array.from({ length: 8 }, (_, index) => ({ classId: index + 1, outcome: "pass" })),
+          { classId: 9, propertyId: "profile-drift", outcome: "finding", violations: ["accepted snapshot differs from the current profile"] },
+          { classId: 10, outcome: "pass" },
+        ],
+      }),
+    },
+  });
+  assert.equal(result.code, "ARCHITECTURE-FITNESS-NOT-READY");
+  assert.match(result.message, /class 9 \(profile-drift\) finding: accepted snapshot differs from the current profile; profile drift is a state of this repository, not of the PRD/u);
+  assert.match(result.message, /architecture-adoption\.mjs status --root <root>/u);
+  assert.match(result.message, /architecture-adoption\.mjs prepare and apply/u);
+  assert.equal(result.nextAction.kind, "repair-required");
+});
+
