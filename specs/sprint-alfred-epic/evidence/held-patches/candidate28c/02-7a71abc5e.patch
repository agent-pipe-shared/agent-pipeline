+    assert.equal(fx.git("diff", "--cached", "--name-only").stdout, "");
+  } finally { fx.cleanup(); }
+});
+
+test("S3: an ignored envelope is staged with -f, as the commit plan always said; another ignored path is not", () => {
+  const fx = repo();
