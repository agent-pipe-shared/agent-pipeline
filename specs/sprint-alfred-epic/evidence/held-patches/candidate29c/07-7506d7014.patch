+    c1Filler(codexHome, project, "08", 1);
+    c1Filler(codexHome, project, "07", 2);
+    codexSegment(codexHome, c1Rollout("02", C1_PARENT), { cwd: project, sessionId: C1_PARENT, metaTimestamp: stamp("05:00:00"), records: c1Spawn("s1", C1_CHILD) });
