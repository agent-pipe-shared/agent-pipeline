+const D47_ATTRIBUTE_LINES = ["specs/**/evidence/** text eol=lf", "evidence/** text eol=lf"];
+const D47_ATTRIBUTE_SEED = `${D47_ATTRIBUTE_LINES.join("\n")}\n`;
+const d47Apply = (path) => applyProjectOnboardingV3(
