 import { sanctionedOnboardingArgs } from "./sanctioned-args-onboarding.mjs";
@@ -78,6 +78,23 @@ function auditPackRequest(args, root) {
   } catch { return null; }
 }
 
+// C19 F2b: the closed analysis-run shape -- `--root` (`.` or the exact root), then optionally one
+// `--commit` (HEAD or a 7-40 char lowercase hex sha) and one `--timeout-seconds` (1..1800, digits only), any order.
+function sanctionedAnalysisRunArgs(args, root) {
+  if (args.length % 2 !== 0) return false;
+  const seen = new Set();
+  for (let index = 0; index < args.length; index += 2) {
+    const flag = args[index], value = args[index + 1];
+    if (seen.has(flag)) return false;
+    seen.add(flag);
+    if (flag === "--root" ? !(value === "." || exactRoot(args, root, index))
+      : flag === "--commit" ? !(value === "HEAD" || /^[0-9a-f]{7,40}$/u.test(value))
+        : flag === "--timeout-seconds" ? !(/^[0-9]{1,4}$/u.test(value) && Number(value) >= 1 && Number(value) <= 1800)
+          : true) return false;
+  }
+  return seen.has("--root");
+}
+
 function designCourseRelativePath(value) {
   return typeof value === "string" && value.length <= 240 && !/[\\:\0]/u.test(value)
     && value.split("/").every((part) => part && !part.startsWith(".") && part !== "scratch" && part !== "node_modules");
