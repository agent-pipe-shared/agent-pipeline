+  const ruleIds = [...new Set(findings.map((row) => row.rule.id))].sort();
+  const indexTree = f.git("write-tree").trim();
+  const scope = { schema: "pipeline.pre-commit-protected-scope.v1", head, indexTree, protectedPaths };
