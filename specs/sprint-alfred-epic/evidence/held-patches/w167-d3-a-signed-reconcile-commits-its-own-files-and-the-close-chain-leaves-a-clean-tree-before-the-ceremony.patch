+  };
+}
+const consume = (f, extra = {}) => { const { toolName, toolInput, denials } = hookCall(f); return hgo.consumeHumanGuardOverride({ rootDir: f.root, pluginRoot: PLUGIN_ROOT, toolName, toolInput, denials, ...extra }); };
