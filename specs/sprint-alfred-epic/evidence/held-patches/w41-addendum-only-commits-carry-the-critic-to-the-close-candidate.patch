+const ADDENDUM_PATH = /^evidence\/dispatch-critic-addendum-([^/]+)\.json$/u;
+const ADDENDUM_EVIDENCE_PATH = /^(?:backlog\/)?evidence\/[^/]+\.md$/u;
+/**
+ * Candidate 15g (consumer finding, close deadlock): the byte-bound Critic disposition addenda the feature close itself instructs the
+ * operator to commit ("commit exactly these paths in one evidence-only commit") can only exist AFTER the last Critic round, because they
+ * name its packet. Counted as corrections they made the Critic carry-forward to HEAD unsolvable. A commit is an addendum-only commit when
+ * it ADDS nothing but `evidence/dispatch-critic-addendum-<task>.json` files and the markdown evidence files they reference, every addendum
+ * validates against the immutable dispatch record it names (already committed), and every added markdown file is referenced by an added
+ * addendum with its exact digest. Nothing executable or reviewable can ride along: a deleted, modified, extra or unreferenced file ends it.
+ */
+export function criticAddendumOnlyCommit(root, commit) {
+  try {
+    const parents = gitBytes(root, ["rev-list", "--parents", "-n", "1", commit], "CCA-RANGE-READ").toString("utf8").trim().split(/\s+/u);
+    if (parents.length !== 2) return false;
+    const fields = gitBytes(root, ["diff", "--name-status", "-z", "--no-renames", parents[1], commit, "--"], "CCA-RANGE-READ").toString("utf8").split("\0").filter(Boolean);
+    if (fields.length === 0 || fields.length % 2 !== 0) return false;
+    const addenda = [];
+    const evidenceFiles = new Set();
+    for (let index = 0; index < fields.length; index += 2) {
+      const path = fields[index + 1];
+      if (fields[index] !== "A") return false;
+      if (ADDENDUM_PATH.test(path)) addenda.push(path);
+      else if (ADDENDUM_EVIDENCE_PATH.test(path)) evidenceFiles.add(path);
+      else return false;
+    }
+    if (addenda.length === 0) return false;
+    const referenced = new Set();
+    for (const path of addenda) {
+      regularBlobAt(root, commit, path);
+      const bytes = gitBytes(root, ["show", `${commit}:${path}`], "CCA-EVIDENCE-READ");
+      const addendum = JSON.parse(bytes.toString("utf8"));
+      const taskId = ADDENDUM_PATH.exec(path)[1];
+      if (!object(addendum) || addendum.taskId !== taskId) return false;
+      const recordPath = `evidence/dispatch-record-${taskId}.json`;
+      regularBlobAt(root, commit, recordPath);
+      const recordBytes = gitBytes(root, ["show", `${commit}:${recordPath}`], "CCA-EVIDENCE-READ");
+      validateCriticDispositionAddendum(addendum, { recordPath, recordBytes, record: JSON.parse(recordBytes.toString("utf8")) });
+      const reference = addendum.criticEvidence;
+      regularBlobAt(root, commit, reference.path);
+      if (digest(gitBytes(root, ["show", `${commit}:${reference.path}`], "CCA-EVIDENCE-READ")) !== reference.sha256) return false;
+      referenced.add(reference.path);
+    }
+    return [...evidenceFiles].every((path) => referenced.has(path));
+  } catch { return false; }
+}
