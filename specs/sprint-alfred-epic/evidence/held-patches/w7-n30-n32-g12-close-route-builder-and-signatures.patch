+  assert.equal(flag(signature.argv, "--kind"), "feature-package-reconcile");
+  assert.equal(flag(signature.argv, "--subject-sha256"), expectedDigest);
+  assert.equal(flag(signature.argv, "--feature-id"), "feature");
