+export function isConsumerReleaseProject(projectDir) {
+  return typeof projectDir === "string" && projectDir !== "" && existsSync(projectDir) && PIPELINE_SOURCE_MANIFESTS.every((path) => !existsSync(join(projectDir, path)));
+}
+
+/**
