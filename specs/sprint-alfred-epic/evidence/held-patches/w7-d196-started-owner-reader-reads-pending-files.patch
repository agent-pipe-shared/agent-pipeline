@@ -1713,3 +1713,34 @@ test("D196 R4: an estimate above twice the base cap plus one grant step warns DB
   assert.ok(warningCodes(farResult).includes("DBG-ESTIMATE-NEEDS-SPLIT"), JSON.stringify(farResult.warnings));
