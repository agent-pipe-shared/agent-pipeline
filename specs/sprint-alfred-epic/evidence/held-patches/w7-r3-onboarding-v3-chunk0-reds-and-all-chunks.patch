+// Every chunk runs, in order, whether or not an earlier chunk had failing shards:
+// a red chunk 0 used to stop the run, so no case of chunk 1 executed in the full
+// suite and its reds stayed hidden until someone ran them by hand. The failing
+// shards of all chunks are returned together; the parent reports each of them and
+// exits non-zero when there is any.
+export async function runAllChunks(chunkCount, runChunk) {
+  const results = [];
+  for (let selectedChunk = 0; selectedChunk < chunkCount; selectedChunk += 1) {
+    results.push(...await runChunk(selectedChunk));
+  }
+  return results;
+}
+// Controller contract for the rule above, with synthetic chunk results: chunk 0 has
+// a failing shard and chunk 1 must still run, and the failing shards of both are
+// reported together (in chunk order).
+async function assertEveryChunkRunsContract() {
+  const ran = [];
+  const shardResult = (index, chunk, code) => ({ index, chunk, code, signal: null, error: null });
+  const results = await runAllChunks(CHUNK_COUNT, async (chunk) => {
+    ran.push(chunk);
+    return chunk === 0
+      ? [shardResult(0, 0, 0), shardResult(1, 0, 1)]
+      : [shardResult(2, 1, 0), shardResult(3, 1, 1)];
+  });
+  assert.deepEqual(ran, [0, 1], "a failing chunk must not stop the next chunk");
+  assert.deepEqual(failedShardResults(results).map(({ chunk, index }) => `${chunk}:${index}`), ["0:1", "1:3"]);
+}
