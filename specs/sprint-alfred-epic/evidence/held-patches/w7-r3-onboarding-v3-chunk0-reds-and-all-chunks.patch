+// The seeded calibration (project/pipeline.json, verify: null) is written but not
+// committed by onboarding. `set-phase --phase implementation --verify-command`
+// runs the calibration commit preflight (NVA-CF-VERIFYDEADLOCK; pipeline-state.mjs
+// -> inspectReplayableCalibrationVerifyLayout -> committedCalibrationPaths), which
+// refuses with CVCT-CALIBRATION unless the baseline calibration is tracked at HEAD;
+// the refusal's own remedy is "Commit the baseline calibration through normal
+// hooks". A consumer does exactly that, with only the calibration paths staged:
+// every calibration tier that is physically present has to be tracked (the
+// preflight refuses a present-but-untracked peer, e.g. the compatibility twin
+// .claude/pipeline.json, with the same code). It must land while the design is
+// still a draft: the plan approval and its request bind the HEAD they were made
+// at, so a later commit would break the transition.
+//
+// The accepted-contract reader (readAcceptedDeliveryContract -> acceptedOriginalMode)
+// also reads the approval-mode policy, pipeline.user.yaml, at the approval's
+// candidate commit, so the seeded policy file is committed with the calibration;
+// its bytes do not change, only its tracked state.
+function commitBaselineCalibration(rootDir) {
+  const paths = ["project/pipeline.json", ".claude/pipeline.json", "pipeline.user.yaml"].filter((path) => existsSync(join(rootDir, path)));
+  assert.ok(paths.includes("project/pipeline.json"), "the seeded neutral calibration must exist");
+  hostGit(rootDir, ["add", "--", ...paths]);
+  hostGit(rootDir, ["-c", "user.name=Fixture", "-c", "user.email=fixture@example.invalid", "commit",
+    "-m", "commit the baseline calibration", "-m", "AI-Assisted: true\nDispatch: stage-0 (elephant)", "--", ...paths]);
+}
+// The second gate that stales a set-phase --verify-command fixture: the calibration
+// transition reads the plan approval through the accepted delivery contract, which
+// resolves its envelope through the feature manifest. `approve-plan` writes the
+// envelope but nothing registers it, so the preflight refuses with
+// CAC-REGISTRATION-INVALID. The shipped writer is register-feature-package.mjs
+// (`--root <root>`); it creates specs/<feature>/lifecycle.json and never commits,
+// which matters here because the approval binds the HEAD it was made at.
+//
+// The third gate: the calibration companion write of `set-phase --phase
+// implementation --verify-command` is only admitted on the source-defaults route
+// (pipeline-state.mjs `sourceDefaults`: the injected dependencies may only be
+// `dir` and `now`), exactly what the shipped command line is. The suite's
+// shared `state()` helper also injects `writeError` and a design-advisory
+// admission, which makes the write refuse with SDC-AUTHORITY-UNAVAILABLE. The
+// verify-command phase entry is therefore run with only `dir` and `now`; its
+// standard error is read from the console, as the CLI writes it there.
+function setPhaseWithVerifyCommand(rootDir, verifyCommand, now) {
+  const stderr = [];
+  const originalError = console.error;
+  console.error = (...values) => { stderr.push(values.join(" ")); };
+  let code;
+  try {
+    code = pipelineStateRun(["set-phase", "--phase", "implementation", "--verify-command", verifyCommand], { dir: rootDir, now });
+  } finally { console.error = originalError; }
+  return { code, stderr: stderr.join("\n") };
+}
