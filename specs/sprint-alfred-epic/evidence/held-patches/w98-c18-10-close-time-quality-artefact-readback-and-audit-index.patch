diff --git a/plugins/pipeline-core/lib/close-quality-readback.mjs b/plugins/pipeline-core/lib/close-quality-readback.mjs
new file mode 100644
index 000000000..e8fc9a7e4
--- /dev/null
+++ b/plugins/pipeline-core/lib/close-quality-readback.mjs
@@ -0,0 +1,131 @@
+// SPDX-License-Identifier: SUL-1.0
+// Read-only readback of the quality artefacts a change should have at close, plus the audit index of one change. It is NOT a gate: it never writes,
+// never runs a scan, never calls the network, and a row whose signal cannot be read is "unknown", never "present". Every reader is injected.
+// Rules (one sentence each):
+//   security-scan         present when both evidence/security-latest.v2.json and its .verdict.json exist (the files check-close-security-completeness.mjs reads).
+//   adr-decision          the typed architecture impact of the close decides: a decision-added/-superseded impact is present when docs/adr has a record and missing otherwise,
+//                         any other typed impact is not-applicable, and no impact signal is unknown.
+//   architecture-fitness  present when the Pipeline State rigorHistory holds an observation for the feature that carries a fitness projection; missing when history is readable without one.
+//   critic-report-file    present when specs/<feature>/evidence/critic/<packetId>/report.md exists for any packet (written by exportSessionCriticEvidence); missing when none does.
+//   handover-freshness    present when the handover file was last updated no more than HANDOVER_FRESHNESS_BOUND_MS before the last commit, missing when it is older.
+// Reader contract: exists(rel)->bool, listDir(rel)->string[] (an absent directory is []), architectureImpact()->string|null, rigorHistory()->array|null,
+// handoverUpdatedMs()->number|null, headCommitMs()->number|null, readBytes(rel)->Buffer. A reader that throws or is not supplied yields "unknown".
+
+import { createHash } from "node:crypto";
+
+export const HANDOVER_FRESHNESS_BOUND_MS = 24 * 60 * 60 * 1000;
+export const QUALITY_ROW_IDS = Object.freeze(["security-scan", "adr-decision", "architecture-fitness", "critic-report-file", "handover-freshness"]);
+export const QUALITY_READBACK_SCHEMA = "pipeline.close-quality-readback.v1";
+export const AUDIT_INDEX_SCHEMA = "pipeline.close-audit-package-index.v1";
+
+export const SECURITY_ENVELOPE_PATH = "evidence/security-latest.v2.json";
+export const SECURITY_VERDICT_PATH = "evidence/security-latest.v2.verdict.json";
+const ADR_DIR = "docs/adr";
+const DECISION_IMPACTS = new Set(["architecture-decision-added", "architecture-decision-superseded"]);
+const NO_DECISION_IMPACTS = new Set(["architecture-conforms", "architecture-summary-updated", "no-architecture-impact"]);
+
+const row = (id, status, evidence = null, remedy = null) => ({ id, status, evidence, remedy });
+const unknown = (id, remedy = null) => row(id, "unknown", null, remedy);
+const call = (fn, ...args) => {
+  if (typeof fn !== "function") return { ok: false };
+  try { return { ok: true, value: fn(...args) }; } catch { return { ok: false }; }
+};
+
+function securityRow(readers) {
+  const id = "security-scan";
+  const remedy = "node <plugin-root>/scripts/security-scan.mjs";
+  const envelope = call(readers.exists, SECURITY_ENVELOPE_PATH);
+  const verdict = call(readers.exists, SECURITY_VERDICT_PATH);
+  if (!envelope.ok || !verdict.ok) return unknown(id, remedy);
+  return envelope.value === true && verdict.value === true ? row(id, "present", SECURITY_ENVELOPE_PATH) : row(id, "missing", null, remedy);
+}
+
+function adrRow(readers) {
+  const id = "adr-decision";
+  const impact = call(readers.architectureImpact);
+  if (!impact.ok || typeof impact.value !== "string") return unknown(id);
+  if (NO_DECISION_IMPACTS.has(impact.value)) return row(id, "not-applicable");
+  if (!DECISION_IMPACTS.has(impact.value)) return unknown(id);
+  const listing = call(readers.listDir, ADR_DIR);
+  if (!listing.ok || !Array.isArray(listing.value)) return unknown(id);
+  return listing.value.length > 0 ? row(id, "present", ADR_DIR) : row(id, "missing");
+}
+
+function fitnessRow(readers, featureId) {
+  const id = "architecture-fitness";
+  const remedy = "node <plugin-root>/scripts/architecture-fitness.mjs --root <root> --check";
+  const history = call(readers.rigorHistory);
+  if (!history.ok || !Array.isArray(history.value)) return unknown(id, remedy);
+  const recorded = history.value.some((entry) => entry?.body?.featureId === featureId && entry.body.fitnessProjection !== null && entry.body.fitnessProjection !== undefined);
+  return recorded ? row(id, "present") : row(id, "missing", null, remedy);
+}
+
+function criticRow(readers, featureId) {
+  const id = "critic-report-file";
+  const remedy = "node <plugin-root>/scripts/session-critic-finalizer.mjs export --root <root> --request <request.json>";
+  const dir = `specs/${featureId}/evidence/critic`;
+  const packets = call(readers.listDir, dir);
+  if (!packets.ok || !Array.isArray(packets.value)) return unknown(id, remedy);
+  for (const packet of packets.value) {
+    const path = `${dir}/${packet}/report.md`;
+    const found = call(readers.exists, path);
+    if (!found.ok) return unknown(id, remedy);
+    if (found.value === true) return row(id, "present", path);
+  }
+  return row(id, "missing", null, remedy);
+}
+
+function handoverRow(readers, handoverPath) {
+  const id = "handover-freshness";
+  const updated = call(readers.handoverUpdatedMs);
+  const head = call(readers.headCommitMs);
+  if (!updated.ok || !head.ok || !Number.isFinite(updated.value) || !Number.isFinite(head.value)) return unknown(id);
+  return head.value - updated.value <= HANDOVER_FRESHNESS_BOUND_MS ? row(id, "present", handoverPath) : row(id, "missing", handoverPath);
+}
+
+export function closeQualityReadback({ featureId, handoverPath = "docs/state.md", readers = {} } = {}) {
+  return [
+    securityRow(readers),
+    adrRow(readers),
+    fitnessRow(readers, featureId),
+    criticRow(readers, featureId),
+    handoverRow(readers, handoverPath),
+  ];
+}
+
+const sha256 = (bytes) => createHash("sha256").update(bytes).digest("hex");
+
+// One JSON index of the change: each path with the sha256 of the file when it exists. Read-only; nothing is written.
+export function buildAuditIndex({ featureId, prdPath = null, specPath = null, rows = [], readers = {} } = {}) {
+  const fileEntry = (id, path) => {
+    if (typeof path !== "string") return { id, path: null, sha256: null };
+    const found = call(readers.exists, path);
+    if (!found.ok || found.value !== true) return { id, path, sha256: null };
+    const bytes = call(readers.readBytes, path);
+    return { id, path, sha256: bytes.ok ? sha256(bytes.value) : null };
+  };
+  const criticDir = `specs/${featureId}/evidence/critic`;
+  const reports = [];
+  const packets = call(readers.listDir, criticDir);
+  if (packets.ok && Array.isArray(packets.value)) {
+    for (const packet of packets.value) {
+      const entry = fileEntry("critic-report", `${criticDir}/${packet}/report.md`);
+      if (entry.sha256 !== null) reports.push(entry);
+    }
+  }
+  return {
+    schema: AUDIT_INDEX_SCHEMA,
+    featureId,
+    entries: [
+      fileEntry("prd", prdPath),
+      fileEntry("spec", specPath),
+      fileEntry("plan", `specs/${featureId}/plan.md`),
+      fileEntry("verify-evidence", "evidence/verify-latest.json"),
+      { id: "critic-reports", path: criticDir, files: reports },
+      fileEntry("security-scan-evidence", SECURITY_ENVELOPE_PATH),
+      fileEntry("fitness-evidence", "architecture/baseline.json"),
+      fileEntry("push-threat-model", "project/push-threat-model.md"),
+    ],
+    qualityRows: rows,
+  };
+}
diff --git a/plugins/pipeline-core/lib/close-quality-readback.test.mjs b/plugins/pipeline-core/lib/close-quality-readback.test.mjs
new file mode 100644
index 000000000..c4db76b74
--- /dev/null
+++ b/plugins/pipeline-core/lib/close-quality-readback.test.mjs
@@ -0,0 +1,96 @@
+// SPDX-License-Identifier: SUL-1.0
+// AC-239: the close reads back which quality artefacts exist for the change. Readers are injected; no repository fixture is needed.
+
+import test from "node:test";
+import assert from "node:assert/strict";
+import { createHash } from "node:crypto";
+import { QUALITY_ROW_IDS, HANDOVER_FRESHNESS_BOUND_MS, closeQualityReadback, buildAuditIndex } from "./close-quality-readback.mjs";
+
+const FEATURE = "feature";
+const SEC = "evidence/security-latest.v2.json";
+const SEC_VERDICT = "evidence/security-latest.v2.verdict.json";
+const CRITIC_DIR = `specs/${FEATURE}/evidence/critic`;
+
+// A reader set describing a change where every artefact exists.
+const full = (over = {}) => ({
+  exists: (p) => new Set([SEC, SEC_VERDICT, `${CRITIC_DIR}/pk-1/report.md`, "docs/state.md"]).has(p),
+  listDir: (p) => (p === CRITIC_DIR ? ["pk-1"] : p === "docs/adr" ? ["0001-x.md"] : []),
+  architectureImpact: () => "architecture-decision-added",
+  rigorHistory: () => [{ body: { featureId: FEATURE, fitnessProjection: { outcomes: [] } } }],
+  handoverUpdatedMs: () => 1_000_000,
+  headCommitMs: () => 1_000_000 + 1000,
+  ...over,
+});
+const rows = (readers) => Object.fromEntries(closeQualityReadback({ root: "<root>", featureId: FEATURE, readers }).map((r) => [r.id, r]));
+
+test("AC-239: exactly the five ids, in order, with the closed row shape", () => {
+  const list = closeQualityReadback({ root: "<root>", featureId: FEATURE, readers: full() });
+  assert.deepEqual(QUALITY_ROW_IDS, ["security-scan", "adr-decision", "architecture-fitness", "critic-report-file", "handover-freshness"]);
+  assert.deepEqual(list.map((r) => r.id), [...QUALITY_ROW_IDS]);
+  for (const row of list) {
+    assert.deepEqual(Object.keys(row).sort(), ["evidence", "id", "remedy", "status"]);
+    assert.ok(["present", "missing", "not-applicable", "unknown"].includes(row.status));
+  }
+  assert.ok(list.every((r) => r.status === "present"), JSON.stringify(list));
+});
+
+test("AC-239 security-scan: present with the envelope path, missing with the scan command, unknown when unreadable", () => {
+  assert.equal(rows(full())["security-scan"].evidence, SEC);
+  const missing = rows(full({ exists: () => false }))["security-scan"];
+  assert.equal(missing.status, "missing");
+  assert.match(missing.remedy, /security-scan\.mjs/u);
+  const unknown = rows(full({ exists: () => { throw new Error("boom"); } }))["security-scan"];
+  assert.equal(unknown.status, "unknown");
+});
+
+test("AC-239 adr-decision: present, not-applicable when no decision qualifies, missing when claimed but absent, unknown without a signal", () => {
+  assert.equal(rows(full())["adr-decision"].status, "present");
+  assert.equal(rows(full({ architectureImpact: () => "no-architecture-impact" }))["adr-decision"].status, "not-applicable");
+  assert.equal(rows(full({ listDir: () => [] }))["adr-decision"].status, "missing");
+  const unknown = rows(full({ architectureImpact: () => null }))["adr-decision"];
+  assert.equal(unknown.status, "unknown");
+  assert.equal(unknown.remedy, null);
+});
+
+test("AC-239 architecture-fitness: present from a recorded run for this feature, missing with the command, unknown without history", () => {
+  assert.equal(rows(full())["architecture-fitness"].status, "present");
+  const missing = rows(full({ rigorHistory: () => [{ body: { featureId: "other", fitnessProjection: {} } }] }))["architecture-fitness"];
+  assert.equal(missing.status, "missing");
+  assert.match(missing.remedy, /architecture-fitness\.mjs/u);
+  assert.equal(rows(full({ rigorHistory: () => null }))["architecture-fitness"].status, "unknown");
+});
+
+test("AC-239 critic-report-file: present with the report path, missing with the export command, unknown when the directory cannot be listed", () => {
+  assert.equal(rows(full())["critic-report-file"].evidence, `${CRITIC_DIR}/pk-1/report.md`);
+  const missing = rows(full({ listDir: (p) => (p === "docs/adr" ? ["a.md"] : []) }))["critic-report-file"];
+  assert.equal(missing.status, "missing");
+  assert.match(missing.remedy, /session-critic-finalizer\.mjs export --root <root> --request <request\.json>/u);
+  assert.equal(rows(full({ listDir: (p) => { if (p === CRITIC_DIR) throw new Error("x"); return []; } }))["critic-report-file"].status, "unknown");
+});
+
+test("AC-239 handover-freshness: within the bound present, older than the bound missing, unreadable unknown", () => {
+  assert.equal(rows(full())["handover-freshness"].evidence, "docs/state.md");
+  const stale = rows(full({ headCommitMs: () => 1_000_000 + HANDOVER_FRESHNESS_BOUND_MS + 1 }))["handover-freshness"];
+  assert.equal(stale.status, "missing");
+  assert.equal(rows(full({ handoverUpdatedMs: () => null }))["handover-freshness"].status, "unknown");
+  assert.ok(HANDOVER_FRESHNESS_BOUND_MS > 0);
+});
+
+test("AC-239: a row is never present when its signal cannot be read, and the readback writes nothing", () => {
+  const all = rows({});
+  for (const id of QUALITY_ROW_IDS) assert.equal(all[id].status, "unknown", id);
+});
+
+test("AC-239 audit index: paths with sha256 only where the file exists", () => {
+  const bytes = { "specs/feature/prd.md": "p", [SEC]: "s" };
+  const index = buildAuditIndex({
+    featureId: FEATURE, prdPath: "specs/feature/prd.md", specPath: "specs/feature/spec.md", rows: [],
+    readers: { exists: (p) => p in bytes, readBytes: (p) => Buffer.from(bytes[p]), listDir: () => [] },
+  });
+  const by = Object.fromEntries(index.entries.map((e) => [e.id, e]));
+  assert.equal(by.prd.sha256, createHash("sha256").update("p").digest("hex"));
+  assert.equal(by.spec.sha256, null);
+  assert.equal(by["security-scan-evidence"].path, SEC);
+  for (const id of ["prd", "spec", "plan", "verify-evidence", "critic-reports", "security-scan-evidence", "fitness-evidence", "push-threat-model"]) assert.ok(by[id], id);
+  assert.deepEqual(index.qualityRows, []);
+});
