diff --git a/plugins/pipeline-core/scripts/human-approval-trace.mjs b/plugins/pipeline-core/scripts/human-approval-trace.mjs
new file mode 100644
index 000000000..ef54450a8
--- /dev/null
+++ b/plugins/pipeline-core/scripts/human-approval-trace.mjs
@@ -0,0 +1,59 @@
+#!/usr/bin/env node
+// SPDX-License-Identifier: SUL-1.0
+/**
+ * Read-only operator command: trace every human approval a gate consumed for a candidate commit back to the human's
+ * detached proof (Q3, AC-108). Prints a table and a typed verdict (`traced`, `attribution-only`, `untraceable`).
+ *   node human-approval-trace.mjs --repo <root> [--commit <oid>] [--format table|json] [--out <repo-relative path>]
+ * Exit 0 for `traced` and `attribution-only`, 1 for `untraceable`, 2 for a command error. `--out` writes the JSON report
+ * create-only inside the repository (for the audit bundle to carry); nothing else is ever written.
+ */
+import { spawnSync } from "node:child_process";
+import { closeSync, mkdirSync, openSync, realpathSync, writeFileSync } from "node:fs";
+import { dirname, isAbsolute, relative, resolve, sep } from "node:path";
+import { pathToFileURL } from "node:url";
+import { canonicalizeJson } from "../lib/governance-event.mjs";
+import { formatHumanApprovalTrace, traceHumanApprovals } from "../lib/human-approval-trace.mjs";
+
+function fail(code, message) { const error = new Error(message); error.code = code; throw error; }
+function parse(argv) {
+  if (argv.length % 2 !== 0) fail("HAT-ARGUMENT", "Usage: human-approval-trace.mjs --repo <root> [--commit <oid>] [--format table|json] [--out <path>]");
+  const flags = new Map();
+  for (let index = 0; index < argv.length; index += 2) {
+    const key = argv[index]; const value = argv[index + 1];
+    if (!["--repo", "--commit", "--format", "--out"].includes(key) || flags.has(key) || value === undefined || value.startsWith("--")) fail("HAT-ARGUMENT", "Human approval trace arguments are invalid.");
+    flags.set(key, value);
+  }
+  if (!flags.has("--repo")) fail("HAT-ARGUMENT", "--repo is required.");
+  const format = flags.get("--format") ?? "table";
+  if (!["table", "json"].includes(format)) fail("HAT-ARGUMENT", "--format must be table or json.");
+  return { repo: flags.get("--repo"), commit: flags.get("--commit") ?? null, format, out: flags.get("--out") ?? null };
+}
+function git(root, args) { const out = spawnSync("git", ["-C", root, ...args], { encoding: "utf8", timeout: 10000, shell: false }); return out.status === 0 ? out.stdout.trim() : null; }
+function reportPath(root, out) {
+  if (isAbsolute(out) || out.includes("\\") || out.split("/").some((part) => part === "" || part === "." || part === "..")) fail("HAT-OUT", "--out must be a plain repository-relative path.");
+  const target = resolve(root, out); const rel = relative(root, target);
+  if (rel === "" || rel === ".." || rel.startsWith(`..${sep}`) || isAbsolute(rel)) fail("HAT-OUT", "--out must stay inside the repository.");
+  return target;
+}
+
+export function main(argv = process.argv.slice(2), deps = {}) {
+  const options = parse(argv); const root = realpathSync(resolve(options.repo));
+  let candidate;
+  if (options.commit !== null) {
+    const commit = /^[a-f0-9]{40,64}$/u.test(options.commit) ? git(root, ["rev-parse", "--verify", `${options.commit}^{commit}`]) : null;
+    const tree = commit === null ? null : git(root, ["rev-parse", `${commit}^{tree}`]);
+    if (commit === null || tree === null) fail("HAT-CANDIDATE", "--commit must name a commit of this repository by its full object id.");
+    candidate = { commit, tree };
+  }
+  const result = (deps.trace ?? traceHumanApprovals)({ repositoryRoot: root, ...(candidate ? { candidate } : {}), ...(deps.machinePlaneDeps ? { machinePlaneDeps: deps.machinePlaneDeps } : {}) });
+  if (options.out !== null) {
+    const target = reportPath(root, options.out); mkdirSync(dirname(target), { recursive: true });
+    const fd = openSync(target, "wx", 0o644); try { writeFileSync(fd, `${canonicalizeJson(result)}\n`); } finally { closeSync(fd); }
+  }
+  return { result, text: options.format === "json" ? `${JSON.stringify(result)}\n` : formatHumanApprovalTrace(result) };
+}
+
+if (process.argv[1] && import.meta.url === pathToFileURL(process.argv[1]).href) {
+  try { const { result, text } = main(); process.stdout.write(text); if (result.status === "untraceable") process.exitCode = 1; }
+  catch (error) { process.stderr.write(`${error.code ?? "HAT-FAILED"}: ${error.message}\n`); process.exitCode = 2; }
+}
diff --git a/plugins/pipeline-core/scripts/human-approval-trace.test.mjs b/plugins/pipeline-core/scripts/human-approval-trace.test.mjs
new file mode 100644
index 000000000..d7c6f4de7
--- /dev/null
+++ b/plugins/pipeline-core/scripts/human-approval-trace.test.mjs
@@ -0,0 +1,54 @@
+// SPDX-License-Identifier: SUL-1.0
+import assert from "node:assert/strict";
+import { execFileSync, spawnSync } from "node:child_process";
+import { existsSync, mkdirSync, mkdtempSync, readFileSync, writeFileSync } from "node:fs";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import test from "node:test";
+import { fileURLToPath } from "node:url";
+import { writeCriticalApproval } from "../lib/critical-action-authorization.mjs";
+import { isSanctionedLifecycleCommand } from "../lib/guard/command-catalogue.mjs";
+
+const script = fileURLToPath(new URL("./human-approval-trace.mjs", import.meta.url));
+const git = (root, ...args) => execFileSync("git", ["-C", root, ...args], { encoding: "utf8" }).trim();
+function repository() {
+  const root = mkdtempSync(join(tmpdir(), "approval-trace-cli-"));
+  git(root, "init", "-q"); git(root, "config", "user.email", "t@example.invalid"); git(root, "config", "user.name", "t");
+  mkdirSync(join(root, "project"), { recursive: true });
+  writeFileSync(join(root, "project", "critical-human-proof.json"), `${JSON.stringify({ schema: "pipeline.critical-human-proof-policy.v3", requiredKinds: ["push"], waivedKinds: [], trustAnchors: [] })}\n`);
+  git(root, "add", "-A"); git(root, "commit", "-q", "-m", "fixture");
+  return { root, commit: git(root, "rev-parse", "HEAD") };
+}
+const run = (...args) => spawnSync(process.execPath, [script, ...args], { encoding: "utf8" });
+
+test("a candidate without any approval record is untraceable: the table names the break and the exit is 1", () => {
+  const { root, commit } = repository(); const result = run("--repo", root);
+  assert.equal(result.status, 1); assert.match(result.stdout, new RegExp(`candidate ${commit}`, "u")); assert.match(result.stdout, /NO-APPROVAL-RECORD/u); assert.match(result.stdout, /verdict: untraceable/u);
+});
+
+test("a chat-mode approval prints attribution-only and exits 0; the JSON form carries the typed verdict", () => {
+  const { root, commit } = repository();
+  const approval = { approvedBy: "Human", approvedAt: "2026-11-04T10:00:00.000Z", forCommit: commit, remote: "origin", destination: "refs/heads/main", threatModel: { path: "x.md", sha256: "a".repeat(64) }, criticalProof: null, criticalProofWaiver: { kind: "push", mode: "chat-attributed-unattested", source: "pipeline.user.yaml" } };
+  assert.equal(writeCriticalApproval({ gitCommonDir: join(root, ".git"), kind: "push", approval }).ok, true);
+  const table = run("--repo", root); assert.equal(table.status, 0); assert.match(table.stdout, /attribution-only/u); assert.match(table.stdout, /verdict: attribution-only/u);
+  const json = JSON.parse(run("--repo", root, "--format", "json", "--commit", commit).stdout); assert.equal(json.status, "attribution-only"); assert.equal(json.rows[0].proofSha256, null);
+});
+
+test("the report is written create-only inside the repository and never anywhere else", () => {
+  const { root } = repository();
+  assert.equal(run("--repo", root, "--out", "scratch/trace.json").status, 1); assert.ok(existsSync(join(root, "scratch", "trace.json")));
+  assert.equal(JSON.parse(readFileSync(join(root, "scratch", "trace.json"), "utf8")).schema, "pipeline.human-approval-trace.v1");
+  for (const bad of ["scratch/trace.json", "../escape.json", "/abs.json"]) { const again = run("--repo", root, "--out", bad); assert.equal(again.status, 2, bad); }
+});
+
+test("the guard admits exactly the read-only argv shapes and never the --out write", () => {
+  const { root, commit } = repository();
+  const admitted = (...args) => isSanctionedLifecycleCommand(`node ${script} ${args.join(" ")}`, root);
+  assert.equal(admitted("--repo", root), true); assert.equal(admitted("--repo", root, "--commit", commit, "--format", "json"), true);
+  for (const bad of [["--repo", root, "--out", "scratch/x.json"], ["--repo", `${root}-other`], ["--repo", root, "--format", "xml"], ["--repo", root, "--commit", "HEAD"], ["--repo", root, "--format", "json", "--format", "table"], ["--repo"]]) assert.equal(admitted(...bad), false, bad.join(" "));
+});
+
+test("bad arguments are a command error (2), not a verdict", () => {
+  const { root } = repository();
+  for (const args of [[], ["--repo"], ["--repo", root, "--format", "xml"], ["--repo", root, "--commit", "HEAD"], ["--repo", root, "--bogus", "x"]]) assert.equal(run(...args).status, 2, args.join(" "));
+});
