diff --git a/plugins/pipeline-core/scripts/runner-capabilities.mjs b/plugins/pipeline-core/scripts/runner-capabilities.mjs
new file mode 100644
index 000000000..5e54bf2f6
--- /dev/null
+++ b/plugins/pipeline-core/scripts/runner-capabilities.mjs
@@ -0,0 +1,45 @@
+#!/usr/bin/env node
+// SPDX-License-Identifier: SUL-1.0
+/**
+ * Prints the sourced per-runner capability table (config/runner-capabilities.json) as one JSON line, or one runner's column.
+ *
+ *   node runner-capabilities.mjs [--runner <claude|codex|antigravity>]
+ *
+ * Read-only. The file states only facts another shipped document or script states; a cell without a source says so. It is
+ * deliberately not part of the start preflight envelope: that readback is pinned and size-budgeted for all three runners, and
+ * the cells have not been measured on a real Codex or Antigravity run.
+ */
+import { readFileSync } from "node:fs";
+import { dirname, join, resolve } from "node:path";
+import { fileURLToPath } from "node:url";
+
+export const RUNNER_CAPABILITIES_SCHEMA = "pipeline.runner-capabilities.v1";
+const RUNNERS = ["claude", "codex", "antigravity"];
+const SOURCE = join(dirname(fileURLToPath(import.meta.url)), "..", "config", "runner-capabilities.json");
+
+export function readRunnerCapabilities(path = SOURCE) {
+  const table = JSON.parse(readFileSync(path, "utf8"));
+  if (table?.schema !== RUNNER_CAPABILITIES_SCHEMA || !Array.isArray(table.rows)) throw new Error("RC-SCHEMA: the capability table is malformed");
+  return table;
+}
+
+export function selectRunner(table, runner) {
+  if (!RUNNERS.includes(runner)) throw new Error(`RC-RUNNER: runner must be one of ${RUNNERS.join(", ")}`);
+  return { schema: table.schema, runner, rows: table.rows.map((row) => ({ topic: row.topic, value: row[runner], owner: row.owner })) };
+}
+
+export function main(argv = process.argv.slice(2), out = process.stdout) {
+  let runner = null;
+  if (argv.length === 2 && argv[0] === "--runner") runner = argv[1];
+  else if (argv.length !== 0) { out.write(`${JSON.stringify({ ok: false, code: "RC-USAGE", message: "usage: runner-capabilities.mjs [--runner <claude|codex|antigravity>]" })}\n`); return 2; }
+  try {
+    const table = readRunnerCapabilities();
+    out.write(`${JSON.stringify(runner === null ? table : selectRunner(table, runner))}\n`);
+    return 0;
+  } catch (error) {
+    out.write(`${JSON.stringify({ ok: false, code: String(error.message).slice(0, 8).replace(/:.*$/u, ""), message: String(error.message).slice(0, 200) })}\n`);
+    return 2;
+  }
+}
+
+if (process.argv[1] !== undefined && resolve(process.argv[1]) === fileURLToPath(import.meta.url)) process.exitCode = main();
diff --git a/plugins/pipeline-core/scripts/runner-capabilities.test.mjs b/plugins/pipeline-core/scripts/runner-capabilities.test.mjs
new file mode 100644
index 000000000..9140fd431
--- /dev/null
+++ b/plugins/pipeline-core/scripts/runner-capabilities.test.mjs
@@ -0,0 +1,64 @@
+// SPDX-License-Identifier: SUL-1.0
+import assert from "node:assert/strict";
+import { existsSync, readFileSync } from "node:fs";
+import { dirname, join } from "node:path";
+import { fileURLToPath } from "node:url";
+import test from "node:test";
+
+import { main, readRunnerCapabilities, selectRunner } from "./runner-capabilities.mjs";
+
+const PLUGIN = join(dirname(fileURLToPath(import.meta.url)), "..");
+const GUIDE = join(PLUGIN, "skills", "pipeline-start", "references", "happy-path.md");
+
+const capture = () => { const lines = []; return { lines, out: { write: (text) => { lines.push(text); } } }; };
+
+test("the table has the three runners, every row has a cell per runner and an owner", () => {
+  const table = readRunnerCapabilities();
+  assert.deepEqual(table.runners, ["claude", "codex", "antigravity"]);
+  assert.ok(table.rows.length >= 8);
+  for (const row of table.rows) {
+    for (const key of ["topic", "claude", "codex", "antigravity", "owner"]) assert.equal(typeof row[key], "string", `${row.topic}: ${key}`);
+    assert.ok(row.owner.length > 0);
+  }
+  assert.equal(new Set(table.rows.map((row) => row.topic)).size, table.rows.length, "topics are unique");
+});
+
+test("the happy-path guide table is the projection of the JSON source, row for row", () => {
+  const table = readRunnerCapabilities();
+  const guide = readFileSync(GUIDE, "utf8");
+  const rows = guide.split("\n").filter((line) => line.startsWith("| ") && !line.startsWith("| Topic") && !line.startsWith("| ---"))
+    .map((line) => line.slice(2, -2).split(" | "));
+  assert.equal(rows.length, table.rows.length);
+  rows.forEach((cells, index) => {
+    const row = table.rows[index];
+    assert.deepEqual(cells, [row.topic, row.claude, row.codex, row.antigravity], `row ${index + 1} (${row.topic}) drifted from the JSON source`);
+  });
+});
+
+test("an owner that names a file in this plugin names one that ships", () => {
+  for (const row of readRunnerCapabilities().rows) {
+    for (const owner of row.owner.split(";").map((part) => part.trim())) {
+      if (owner.startsWith("docs/")) continue; // repository documentation, vendored separately
+      const relative = owner.replace(/^references\//u, "skills/pipeline-start/references/");
+      assert.ok(existsSync(join(PLUGIN, relative)), `${row.topic}: owner ${owner} does not ship`);
+    }
+  }
+});
+
+test("the CLI prints the table, one runner's column, and refuses anything else", () => {
+  const all = capture();
+  assert.equal(main([], all.out), 0);
+  assert.equal(JSON.parse(all.lines.join("")).schema, "pipeline.runner-capabilities.v1");
+  const one = capture();
+  assert.equal(main(["--runner", "antigravity"], one.out), 0);
+  const column = JSON.parse(one.lines.join(""));
+  assert.equal(column.runner, "antigravity");
+  assert.equal(column.rows.find((row) => row.topic === "Close entry").value, "`finish-feature.mjs` single entry");
+  const bad = capture();
+  assert.equal(main(["--runner", "gemini"], bad.out), 2);
+  assert.equal(JSON.parse(bad.lines.join("")).ok, false);
+  const usage = capture();
+  assert.equal(main(["--all"], usage.out), 2);
+  assert.equal(JSON.parse(usage.lines.join("")).code, "RC-USAGE");
+  assert.throws(() => selectRunner(readRunnerCapabilities(), "gemini"), /RC-RUNNER/u);
+});
