+export function exportCriticRoundFromJournal({ root: rootInput, packetId, outDir }, deps = {}) {
+  const root = realpathSync(resolve(rootInput));
+  if (!PACKET_ID.test(packetId ?? "")) fail("SCF-EXPORT-REQUEST");
