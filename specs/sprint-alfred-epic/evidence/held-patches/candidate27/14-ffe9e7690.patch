+/** The report of a round nobody exported by hand: the verdict the journal holds, and nothing else. The Critic's working notes never enter it. */
+function renderJournalCriticReport(packetId, receipt, verdict) {
+  const text = (value) => String(value ?? "").replace(/\s+/gu, " ").trim();
+  const findings = Array.isArray(verdict.findings) ? verdict.findings : [];
+  const lines = [
+    `# Critic round ${packetId}`, "",
+    "Generated by the close from the private Critic journal. The verdict matches the digest in `receipt.json`. The Critic's working notes are not part of this report.", "",
+    `- Candidate: \`${receipt.candidate.commit}\``,
+    `- Reviewed range: \`${receipt.reviewRange.base}..${receipt.reviewRange.commit}\``,
+    `- Review passed: ${receipt.reviewPass ? "yes" : "no"}`,
+    `- Trajectory: ${text(verdict.trajectory_verdict)}${text(verdict.trajectory_evidence) === "" ? "" : ` (${text(verdict.trajectory_evidence)})`}`,
+    `- Findings: ${findings.length}`,
+  ];
+  findings.forEach((finding, position) => {
+    lines.push("", `## Finding ${position + 1} (${text(finding.severity)})`, "", text(finding.gap), "", `- Risk: ${text(finding.risk)}`, `- Evidence: ${text(finding.evidence)}`, `- Spec reference: ${text(finding.spec_ref)}`);
+  });
+  return Buffer.from(`${lines.join("\n")}\n`, "utf8");
+}
