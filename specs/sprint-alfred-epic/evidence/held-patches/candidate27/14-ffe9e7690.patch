+    consumed = (deps.readConsumedCandidateResultFn ?? readConsumedCandidateResult)({ controlRoot: join(common, "agent-pipeline", "critic-packets"), packetId });
+  } catch { fail("SCF-EXPORT-UNCONSUMED"); }
+  const verdict = consumed?.result?.verdict;
+  if (!record(verdict) || !record(consumed?.receipt) || sha256(canonicalJson(verdict)) !== consumed.receipt.verdictSha256) fail("SCF-EXPORT-UNCONSUMED");
+  return exportSessionCriticEvidence({ root, packetId, outDir, reportBytes: renderJournalCriticReport(packetId, consumed.receipt, verdict), skipLineage: true }, deps);
+}
