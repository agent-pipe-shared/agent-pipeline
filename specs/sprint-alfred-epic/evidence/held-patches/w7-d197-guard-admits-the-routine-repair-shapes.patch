+  }
+  if (kind === "move-aside") {
+    return positional.length === 0 && values.size === 2 && booleans.size === 1 && booleans.has("--no-goldfish-running");
+  }
+  return positional.length === 0 && values.size === 2 && booleans.size === 0;
+}
