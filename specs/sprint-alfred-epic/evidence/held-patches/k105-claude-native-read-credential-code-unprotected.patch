+// K105 (PO decision 2026-10-23, asked after K96): the Claude native Read/Grep/Glob lane (read-scope.mjs) speaks with the same typed code and
+// repair as the shell lane and the Antigravity native tools. It was GUARD-READ-TARGET ("use an exact passive path outside protected
+// credential roots"), which does not name the path as the cause and offers no repair.
+test("M8 Claude native Read, Grep and Glob of a credential target are refused with GUARD-READ-CREDENTIAL-TARGET and its repair; non-credential refusals keep GUARD-READ-TARGET; an in-root file stays allowed", () => withFixture((path) => {
+  const secret = join(path, "vault", "id_rsa");
+  for (const input of [
+    { tool_name: "Read", tool_input: { file_path: secret } },
+    { tool_name: "Read", tool_input: { file_path: "vault/id_rsa" } },
+    { tool_name: "Read", tool_input: { file_path: fwd(secret) } },
+    { tool_name: "Grep", tool_input: { pattern: "x", path: secret } },
+    { tool_name: "Grep", tool_input: { pattern: "x", path: secret, glob: "*" } },
+    { tool_name: "Glob", tool_input: { pattern: "id_rsa", path: join(path, "vault") } },
+  ]) {
+    const r = run(input, path);
+    assertCredentialTargetDenial({ denied: r.exitCode === 2, text: r.text }, JSON.stringify(input));
+    assert.doesNotMatch(r.text, /GUARD-READ-TARGET[^-]/u, `${JSON.stringify(input)}: the generic code is replaced, not printed beside it\n${r.text}`);
+  }
+  // Negative controls: the path is not a credential, so the refusal keeps its own code (and the text of the previous behaviour).
+  for (const input of [
+    { tool_name: "Read", tool_input: { file_path: join(path, "..", "..", "outside.md") } },
+    { tool_name: "Grep", tool_input: { pattern: "a", path: join(path, "docs") } },
+    { tool_name: "Grep", tool_input: { pattern: "a", path: join(path, "vault") } },
+    { tool_name: "Glob", tool_input: { pattern: "../*", path } },
+  ]) {
+    const r = run(input, path);
+    assert.equal(r.exitCode, 2, JSON.stringify(input));
+    assert.match(r.text, /GUARD-READ-TARGET:/u, `${JSON.stringify(input)}\n${r.text}`);
+    assert.doesNotMatch(r.text, CREDENTIAL_CODE, `${JSON.stringify(input)} is not a credential path\n${r.text}`);
+  }
+  assert.equal(run({ tool_name: "Read", tool_input: { file_path: join(path, "docs", "2026-09-21-a.md") } }, path).exitCode, 0);
+  assert.equal(run({ tool_name: "Grep", tool_input: { pattern: "apply", path: join(path, "docs", "2026-09-21-a.md") } }, path).exitCode, 0);
+  // The three read routes speak with one text: the Claude native lane's refusal carries the same repair lines as the Antigravity one.
+  const claudeText = run({ tool_name: "Read", tool_input: { file_path: secret } }, path).text;
+  assert.match(claudeText, /A signed override is a shell-command route only/u, claudeText);
+}));
