diff --git a/plugins/pipeline-core/lib/agy-native-implementation-admission.mjs b/plugins/pipeline-core/lib/agy-native-implementation-admission.mjs
new file mode 100644
index 000000000..7d460f329
--- /dev/null
+++ b/plugins/pipeline-core/lib/agy-native-implementation-admission.mjs
@@ -0,0 +1,65 @@
+// SPDX-License-Identifier: SUL-1.0
+// Admission of a NATIVE Antigravity `invoke_subagent` call that names an implementation role (goldfish-implementor, goldfish-mechanic).
+//
+// Until this module the guard refused such a call unconditionally (AGY-NATIVE-IMPLEMENTATION-CONSENT-UNAVAILABLE): a native hook call carries
+// no authenticated parent identity. The PO decided on 2026-11-02 to build the native route anyway, on assumptions that are labelled and kept
+// narrow. It stays deny-by-default and admits a call only when ALL of the following hold, none of which the agent can supply by itself:
+//
+//   1. the hook payload names a session (UNMEASURED ASSUMPTION, not measured on a real Antigravity host: the payload's session id is the
+//      PARENT session's; nothing here claims the admission works in a real Antigravity run);
+//   2. that session has a descriptor, its owner is live, and it has a stored v1 session consent that validates (signature or chat mode as
+//      configured), unexpired and bound to that exact session and repository;
+//   3. the consent's SIGNED subject scope carries `nativeImplementation: { schema, models: [...] }` -- the PO's explicit grant of the native
+//      route and of the exact Model aliases (flash_lite | flash | pro) it may use, so no alias-to-model-id mapping is guessed here;
+//   4. every implementation entry's role is in the consent's signed role list and its Model alias is in that grant.
+//
+// A v2 (model-family) consent is not accepted here: its binding is rechecked by the family dispatch path only. Any missing piece is a typed
+// refusal that names the cause and the sanctioned alternative (elephant-implementation-dispatch.mjs). Nothing is written.
+
+import { loadLiveSession, loadStoredConsent, validateConsentRecord, AGY_FAMILY_CONSENT_SCHEMA } from "./agy-session-authority.mjs";
+import { loadSessionDescriptor } from "./worktree-lifecycle.mjs";
+
+export const NATIVE_IMPLEMENTATION_SCOPE_SCHEMA = "pipeline.agy-native-implementation-scope.v1";
+export const NATIVE_ASSURANCE = "unmeasured-hook-session-id";
+const NATIVE_MODELS = new Set(["flash_lite", "flash", "pro"]);
+
+const roleOf = (entry) => {
+  const type = typeof entry?.TypeName === "string" && entry.TypeName.startsWith("pipeline-core:") ? entry.TypeName.slice("pipeline-core:".length) : entry?.TypeName;
+  return type === "goldfish-implementor" || type === "goldfish-mechanic" ? `pipeline-core:${type}` : null;
+};
+
+export function evaluateNativeImplementationAdmission({ root, hookSessionId, subagents, nowEpochMs = Date.now() } = {}, deps = {}) {
+  const deny = (code, reason) => ({ ok: false, code, reason });
+  const implementation = (Array.isArray(subagents) ? subagents : []).map((entry) => ({ entry, role: roleOf(entry) })).filter((item) => item.role !== null);
+  if (implementation.length === 0) return { ok: true, assurance: null, implementation: 0 };
+  if (typeof root !== "string" || typeof hookSessionId !== "string" || hookSessionId === "") {
+    return deny("AGY-NATIVE-SESSION-UNIDENTIFIED", "the hook payload names no session, so no stored consent can be bound to this call");
+  }
+  let descriptor;
+  try { descriptor = (deps.loadSessionDescriptor ?? loadSessionDescriptor)(root, hookSessionId); }
+  catch { return deny("AGY-NATIVE-SESSION-UNKNOWN", "the hook session has no session descriptor in this repository"); }
+  const descriptorSha256 = descriptor?.descriptorSha256;
+  let live;
+  try { live = (deps.loadLiveSession ?? loadLiveSession)(root, hookSessionId, descriptorSha256); }
+  catch { return deny("AGY-SESSION-OWNER-UNAVAILABLE", "the session owner could not be inspected"); }
+  if (!live?.ok) return deny(live?.code ?? "AGY-SESSION-OWNER-UNAVAILABLE", "the session owner is not live");
+  let stored;
+  try { stored = (deps.loadStoredConsent ?? loadStoredConsent)(root, hookSessionId, descriptorSha256); }
+  catch { return deny("AGY-SESSION-CONSENT-UNAVAILABLE", "the stored session consent could not be read"); }
+  if (!stored?.record) return deny("AGY-SESSION-CONSENT-REQUIRED", "this session has no stored consent");
+  if (stored.record.schema === AGY_FAMILY_CONSENT_SCHEMA) return deny("AGY-NATIVE-CONSENT-FAMILY-UNSUPPORTED", "a model-family consent is rechecked only by the family dispatch route");
+  const verified = (deps.validateConsentRecord ?? validateConsentRecord)(stored.record, {
+    root, repository: stored.descriptor?.repo ?? live.descriptor?.repo, session: live.session, nowEpochMs, policy: deps.policy,
+  });
+  if (!verified?.ok) return deny(verified?.code ?? "AGY-CONSENT-INVALID", "the stored consent does not validate");
+  const grant = stored.record.subject?.scope?.nativeImplementation;
+  if (grant?.schema !== NATIVE_IMPLEMENTATION_SCOPE_SCHEMA || !Array.isArray(grant.models) || grant.models.length === 0
+    || grant.models.some((model) => !NATIVE_MODELS.has(model))) {
+    return deny("AGY-NATIVE-SCOPE-NOT-GRANTED", `the signed consent scope carries no valid nativeImplementation grant (schema ${NATIVE_IMPLEMENTATION_SCOPE_SCHEMA}, models from flash_lite|flash|pro)`);
+  }
+  for (const { entry, role } of implementation) {
+    if (!stored.record.subject.roles.includes(role)) return deny("AGY-CONSENT-ROLE-MISMATCH", `${role} is not in the consent's signed role list`);
+    if (!grant.models.includes(entry.Model)) return deny("AGY-NATIVE-MODEL-NOT-GRANTED", `Model ${JSON.stringify(entry.Model ?? null)} is not in the consent's native grant`);
+  }
+  return { ok: true, assurance: NATIVE_ASSURANCE, implementation: implementation.length, sessionId: hookSessionId, consentSubjectSha256: stored.record.subjectSha256 };
+}
diff --git a/plugins/pipeline-core/lib/agy-native-implementation-admission.test.mjs b/plugins/pipeline-core/lib/agy-native-implementation-admission.test.mjs
new file mode 100644
index 000000000..effc08cd1
--- /dev/null
+++ b/plugins/pipeline-core/lib/agy-native-implementation-admission.test.mjs
@@ -0,0 +1,119 @@
+// SPDX-License-Identifier: SUL-1.0
+// Criterion-bound cases for the native Antigravity implementation admission (AC-108 closest accepted criterion): deny by default, admit only
+// under a stored v1 session consent whose SIGNED scope carries a nativeImplementation grant. All dependencies are injected; the hook payload's
+// session id being the parent's is an UNMEASURED assumption (no real Antigravity run was made).
+import assert from "node:assert/strict";
+import test from "node:test";
+import { evaluateNativeImplementationAdmission, NATIVE_IMPLEMENTATION_SCOPE_SCHEMA } from "./agy-native-implementation-admission.mjs";
+
+const SHA = "a".repeat(64);
+const IMPL = (extra = {}) => ({ TypeName: "pipeline-core:goldfish-implementor", Model: "flash", Prompt: "x", ...extra });
+const grant = (models = ["flash"]) => ({ schema: NATIVE_IMPLEMENTATION_SCOPE_SCHEMA, models });
+const record = ({ scope = { nativeImplementation: grant() }, roles = ["pipeline-core:goldfish-implementor"], schema = "pipeline.agy-session-consent.v1" } = {}) => ({
+  schema, subjectSha256: "b".repeat(64), subject: { roles, scope },
+});
+function deps(overrides = {}) {
+  return {
+    loadSessionDescriptor: () => ({ descriptorSha256: SHA, repo: { primaryRoot: "r" } }),
+    loadLiveSession: () => ({ ok: true, session: { id: "s1", descriptorSha256: SHA }, descriptor: { repo: { primaryRoot: "r" } } }),
+    loadStoredConsent: () => ({ descriptor: { repo: { primaryRoot: "r" } }, record: record() }),
+    validateConsentRecord: () => ({ ok: true, mode: "signature" }),
+    ...overrides,
+  };
+}
+const call = (args = {}, d = deps()) => evaluateNativeImplementationAdmission({ root: "/r", hookSessionId: "s1", subagents: [IMPL()], ...args }, d);
+
+test("a call naming no implementation role needs no admission", () => {
+  const result = call({ subagents: [{ TypeName: "pipeline-core:critic", Model: "pro" }] });
+  assert.equal(result.ok, true);
+  assert.equal(result.implementation, 0);
+});
+
+test("deny 1: a payload without a session is refused before any lookup", () => {
+  const boom = () => { throw new Error("must not be reached"); };
+  const d = deps({ loadSessionDescriptor: boom, loadLiveSession: boom, loadStoredConsent: boom });
+  for (const hookSessionId of [undefined, "", null]) {
+    const result = call({ hookSessionId }, d);
+    assert.equal(result.ok, false);
+    assert.equal(result.code, "AGY-NATIVE-SESSION-UNIDENTIFIED");
+  }
+  assert.equal(call({ root: null }).code, "AGY-NATIVE-SESSION-UNIDENTIFIED");
+});
+
+test("deny 2: an unknown session descriptor is refused", () => {
+  const result = call({}, deps({ loadSessionDescriptor: () => { throw new Error("none"); } }));
+  assert.deepEqual([result.ok, result.code], [false, "AGY-NATIVE-SESSION-UNKNOWN"]);
+});
+
+test("deny 3: a session whose owner is not live is refused with the owner code", () => {
+  const dead = call({}, deps({ loadLiveSession: () => ({ ok: false, code: "AGY-SESSION-OWNER-DEAD" }) }));
+  assert.deepEqual([dead.ok, dead.code], [false, "AGY-SESSION-OWNER-DEAD"]);
+  const thrown = call({}, deps({ loadLiveSession: () => { throw new Error("x"); } }));
+  assert.deepEqual([thrown.ok, thrown.code], [false, "AGY-SESSION-OWNER-UNAVAILABLE"]);
+});
+
+test("deny 4: a missing or unreadable stored consent is refused", () => {
+  const none = call({}, deps({ loadStoredConsent: () => ({ record: null }) }));
+  assert.deepEqual([none.ok, none.code], [false, "AGY-SESSION-CONSENT-REQUIRED"]);
+  const thrown = call({}, deps({ loadStoredConsent: () => { throw new Error("x"); } }));
+  assert.deepEqual([thrown.ok, thrown.code], [false, "AGY-SESSION-CONSENT-UNAVAILABLE"]);
+});
+
+test("deny 5: a model-family (v2) consent is refused", () => {
+  const result = call({}, deps({ loadStoredConsent: () => ({ record: record({ schema: "pipeline.agy-session-consent.v2" }) }) }));
+  assert.deepEqual([result.ok, result.code], [false, "AGY-NATIVE-CONSENT-FAMILY-UNSUPPORTED"]);
+});
+
+test("deny 6: a consent that does not validate is refused with the validator code", () => {
+  const result = call({}, deps({ validateConsentRecord: () => ({ ok: false, code: "AGY-CONSENT-PROOF-MISSING" }) }));
+  assert.deepEqual([result.ok, result.code], [false, "AGY-CONSENT-PROOF-MISSING"]);
+});
+
+test("deny 7: a signed scope without a valid nativeImplementation grant is refused", () => {
+  const scopes = [
+    {},
+    { nativeImplementation: { schema: "wrong", models: ["flash"] } },
+    { nativeImplementation: { schema: NATIVE_IMPLEMENTATION_SCOPE_SCHEMA, models: [] } },
+    { nativeImplementation: { schema: NATIVE_IMPLEMENTATION_SCOPE_SCHEMA, models: ["gemini-3.8-flash-high"] } },
+    { nativeImplementation: { schema: NATIVE_IMPLEMENTATION_SCOPE_SCHEMA } },
+  ];
+  for (const scope of scopes) {
+    const result = call({}, deps({ loadStoredConsent: () => ({ record: record({ scope }) }) }));
+    assert.deepEqual([result.ok, result.code], [false, "AGY-NATIVE-SCOPE-NOT-GRANTED"], JSON.stringify(scope));
+  }
+});
+
+test("deny 8: a role outside the signed role list is refused", () => {
+  const result = call({ subagents: [IMPL({ TypeName: "pipeline-core:goldfish-mechanic" })] });
+  assert.deepEqual([result.ok, result.code], [false, "AGY-CONSENT-ROLE-MISMATCH"]);
+});
+
+test("deny 9: a Model alias outside the grant is refused", () => {
+  for (const Model of ["pro", undefined]) {
+    const result = call({ subagents: [IMPL({ Model })] });
+    assert.deepEqual([result.ok, result.code], [false, "AGY-NATIVE-MODEL-NOT-GRANTED"]);
+  }
+});
+
+test("deny order: the first failing reason wins when several fail", () => {
+  const d = deps({ loadSessionDescriptor: () => { throw new Error("none"); }, loadStoredConsent: () => ({ record: null }) });
+  assert.equal(call({}, d).code, "AGY-NATIVE-SESSION-UNKNOWN");
+});
+
+test("admit: a live session with a valid v1 consent carrying a grant for the role and Model", () => {
+  const seen = [];
+  const d = deps({ validateConsentRecord: (rec, opts) => { seen.push(opts.session.id); return { ok: true }; } });
+  const result = call({ subagents: [IMPL(), { TypeName: "pipeline-core:critic", Model: "pro" }] }, d);
+  assert.equal(result.ok, true);
+  assert.equal(result.implementation, 1);
+  assert.equal(result.assurance, "unmeasured-hook-session-id");
+  assert.equal(result.sessionId, "s1");
+  assert.equal(result.consentSubjectSha256, "b".repeat(64));
+  assert.deepEqual(seen, ["s1"]);
+});
+
+test("admit: the bare role name and a granted second alias are accepted", () => {
+  const rec = record({ scope: { nativeImplementation: grant(["flash", "pro"]) } });
+  const result = call({ subagents: [IMPL({ TypeName: "goldfish-implementor", Model: "pro" })] }, deps({ loadStoredConsent: () => ({ record: rec }) }));
+  assert.equal(result.ok, true);
+});
