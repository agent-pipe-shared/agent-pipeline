diff --git a/plugins/pipeline-core/lib/critic-route-assurance.mjs b/plugins/pipeline-core/lib/critic-route-assurance.mjs
new file mode 100644
index 000000000..ee34d36b2
--- /dev/null
+++ b/plugins/pipeline-core/lib/critic-route-assurance.mjs
@@ -0,0 +1,75 @@
+// SPDX-License-Identifier: SUL-1.0
+/**
+ * C22 (CGF-03, CGF-20, AC-108): the assurance a Critic route will really deliver, stated BEFORE the dispatch. The Codex greenfield run learned that its
+ * Critic was caller-authored (receipt: freshContext false, historyInherited true, `caller-authored-fallback`) only at the close, which then asked for a
+ * PO acknowledgement nobody had planned for. This module reads the planned route and states, in the receipt's own vocabulary and never a stronger word,
+ * what the finalized receipt will say and whether the close will need its own acknowledgement. Pure: no I/O, no state, never throws.
+ *
+ * It is a notice, not a gate. A route below the critical profile is not refused here: the one exception route that already exists for it is the PO
+ * acknowledgement of exactly this packet at the close (`pipeline-state.mjs approve-critic-acknowledgement`, critic-acknowledgement.mjs), so the rule
+ * never deadlocks, and the close gate (close-coordinator.mjs `assertCriticIndependenceForClose`) stays the one enforcing check.
+ */
+const RECEIPT_SOURCE = Object.freeze({ independence: "source-issued-origin", freshContext: true, historyInherited: false });
+const RECEIPT_FALLBACK = Object.freeze({ independence: "caller-authored-fallback", freshContext: false, historyInherited: true });
+const CRITICAL_TRIGGERS = Object.freeze(["T1", "T2"]);
+const PACKET_ID = /^[a-f0-9]{32}$/u;
+
+export const CRITIC_ROUTE_ASSURANCE_SCHEMA = "pipeline.critic-route-assurance.v1";
+
+/** The runner of the calling session from its own markers; `unknown` when none is present (the assurance then promises nothing). */
+export function criticRunnerFromEnv(env) {
+  const source = env !== null && typeof env === "object" ? env : {};
+  if (source.CODEX_SESSION_ID !== undefined || source.CODEX_THREAD_ID !== undefined) return "codex";
+  if (source.ANTIGRAVITY_AGENT !== undefined) return "antigravity";
+  if (source.CLAUDECODE !== undefined || source.CLAUDE_CODE_SESSION_ID !== undefined) return "claude";
+  return "unknown";
+}
+
+// What the finalized receipt will carry, from the planned route. Null where no route is decided yet: nothing stronger than the floor is promised.
+function expectedReceipt(runner, launchRoute) {
+  if (runner === "claude" || runner === "antigravity") return RECEIPT_SOURCE;
+  if (runner !== "codex" || launchRoute === null || typeof launchRoute !== "object" || typeof launchRoute.agentType !== "string") return null;
+  return launchRoute.sandboxed === true ? RECEIPT_SOURCE : RECEIPT_FALLBACK;
+}
+
+/**
+ * @param {{ runner?: string, trigger?: string, rigor?: number|null, packetId?: string, launchRoute?: object|null }} input `launchRoute` is the output of
+ *   decideCodexCriticLaunchRoute (Codex only); `rigor` is the feature package's rigor when readable, else null.
+ */
+export function describeCriticRouteAssurance(input) {
+  const { runner = "unknown", trigger = "T1", rigor = null, packetId = null, launchRoute = null } = input !== null && typeof input === "object" ? input : {};
+  const expected = expectedReceipt(runner, launchRoute);
+  const critical = CRITICAL_TRIGGERS.includes(trigger) || !["T1", "T2", "T3"].includes(trigger);
+  // The close rule (close-coordinator.mjs): a caller-authored round satisfies the close only at rigor 0 and low risk; the critical profile is the high-risk duty.
+  const whenFallback = critical || (Number.isInteger(rigor) && rigor >= 1) ? true : rigor === 0 ? false : "unknown";
+  const required = expected === null ? (whenFallback === false ? false : "conditional") : expected === RECEIPT_FALLBACK ? whenFallback : false;
+  const packet = typeof packetId === "string" && PACKET_ID.test(packetId) ? packetId : "<packet-id>";
+  const command = `node \${PIPELINE_PLUGIN_ROOT}/scripts/pipeline-state.mjs approve-critic-acknowledgement --by <name> --critic-packet ${packet}`;
+  const status = !critical ? "not-critical" : expected === null ? "conditional" : expected === RECEIPT_SOURCE ? "meets" : "below-required";
+  const exception = status === "below-required" || status === "conditional"
+    ? Object.freeze({ route: "po-acknowledgement", command, note: "a deliberate, recorded exception for exactly this packet and its candidate; never inferred, never generic" }) : null;
+  const unknownRoute = expected === null
+    ? (runner === "codex" ? "the Codex launch route is decided at launch from this machine's sandbox receipt: a sandboxed role gives a source-issued round, the default route gives the caller-authored fallback"
+      : "no Critic route is known for this runner")
+    : null;
+  const words = (value) => `${value.independence} (freshContext ${value.freshContext}, historyInherited ${value.historyInherited})`;
+  const notice = [
+    expected === null ? `No Critic assurance is promised yet: ${unknownRoute}; the floor is ${words(RECEIPT_FALLBACK)}.`
+      : `The planned Critic route will be recorded as ${words(expected)}${expected === RECEIPT_FALLBACK ? ", protected by instruction only" : ""}.`,
+    required === true ? `The close will need the PO acknowledgement of this round (${critical ? "critical profile" : "rigor 1 or more"}): ${command}.`
+      : required === "conditional" || required === "unknown" ? `If the round is recorded as the fallback, the close will need the PO acknowledgement of this round: ${command}.`
+        : "The close needs no separate acknowledgement unless the round is finalized as the fallback.",
+    status === "below-required" ? "This is below the critical profile; the acknowledgement above is the deliberate exception." : "",
+  ].filter(Boolean).join(" ");
+  return Object.freeze({
+    schema: CRITIC_ROUTE_ASSURANCE_SCHEMA,
+    runner: typeof runner === "string" ? runner : "unknown",
+    plannedRoute: Object.freeze({ agentType: typeof launchRoute?.agentType === "string" ? launchRoute.agentType : null, sandboxed: typeof launchRoute?.sandboxed === "boolean" ? launchRoute.sandboxed : null }),
+    expected,
+    floor: RECEIPT_FALLBACK,
+    profile: Object.freeze({ name: critical ? "critical" : "standard", status }),
+    closeAcknowledgement: Object.freeze({ required, whenFallback, command }),
+    exception,
+    notice,
+  });
+}
diff --git a/plugins/pipeline-core/lib/critic-route-assurance.test.mjs b/plugins/pipeline-core/lib/critic-route-assurance.test.mjs
new file mode 100644
index 000000000..0548b4994
--- /dev/null
+++ b/plugins/pipeline-core/lib/critic-route-assurance.test.mjs
@@ -0,0 +1,89 @@
+// SPDX-License-Identifier: SUL-1.0
+// C22 (CGF-03, CGF-20, AC-108): criterion-bound cases for the assurance a Critic route will really deliver, stated BEFORE the dispatch. Written before the module existed.
+// Source: Codex greenfield report CGF-03 ("independence and test-first assurance must not be upgraded in wording: the receipt says freshContext:false,
+// historyInherited:true, caller-authored-fallback"; critical profile blocks or takes a deliberate exception up front) and CGF-20 ("a caller-authored Critic
+// needs its own acknowledgement only late in close": avoidable late discovery).
+import assert from "node:assert/strict";
+import test from "node:test";
+import { CRITIC_ROUTE_ASSURANCE_SCHEMA, criticRunnerFromEnv, describeCriticRouteAssurance } from "./critic-route-assurance.mjs";
+
+const PACKET = "a".repeat(32);
+const DEFAULT_ROUTE = { agentType: "default", sandboxed: false, protection: "instruction-only", reason: "no-receipt" };
+const SANDBOXED = { agentType: "critic-high-risk", sandboxed: true };
+const describe = (input) => describeCriticRouteAssurance({ packetId: PACKET, trigger: "T1", rigor: null, launchRoute: null, ...input });
+
+test("a native Claude or Antigravity Critic is stated with the receipt vocabulary of a source-issued round, with the fallback as its floor", () => {
+  for (const runner of ["claude", "antigravity"]) {
+    const result = describe({ runner });
+    assert.equal(result.schema, CRITIC_ROUTE_ASSURANCE_SCHEMA);
+    assert.deepEqual(result.expected, { independence: "source-issued-origin", freshContext: true, historyInherited: false });
+    assert.equal(result.floor.independence, "caller-authored-fallback", "a round whose stop issues no Source return is finalized as the fallback");
+    assert.equal(result.profile.status, "meets");
+    assert.equal(result.closeAcknowledgement.required, false);
+  }
+});
+
+test("a Codex route that resolves to default is stated as caller-authored, history inherited, and below the critical profile, with its close acknowledgement named now", () => {
+  const result = describe({ runner: "codex", launchRoute: DEFAULT_ROUTE });
+  assert.deepEqual(result.expected, { independence: "caller-authored-fallback", freshContext: false, historyInherited: true });
+  assert.equal(result.plannedRoute.agentType, "default");
+  assert.equal(result.profile.name, "critical");
+  assert.equal(result.profile.status, "below-required");
+  assert.equal(result.closeAcknowledgement.required, true, "CGF-20: the late discovery is gone, the preflight says it before the dispatch");
+  assert.ok(result.closeAcknowledgement.command.includes(`approve-critic-acknowledgement --by <name> --critic-packet ${PACKET}`), result.closeAcknowledgement.command);
+  assert.equal(result.exception.route, "po-acknowledgement", "the existing exception route, never a refusal without a way out");
+  assert.match(result.notice, /caller-authored-fallback/u);
+  assert.match(result.notice, /instruction only/u);
+});
+
+test("a sandboxed Codex Critic meets the critical profile; an undecided Codex launch states the floor and both outcomes instead of the stronger one", () => {
+  const sandboxed = describe({ runner: "codex", launchRoute: SANDBOXED });
+  assert.equal(sandboxed.expected.independence, "source-issued-origin");
+  assert.equal(sandboxed.profile.status, "meets");
+  const undecided = describe({ runner: "codex" });
+  assert.equal(undecided.expected, null, "no launch route is known yet, so no assurance is promised");
+  assert.equal(undecided.floor.independence, "caller-authored-fallback");
+  assert.equal(undecided.profile.status, "conditional");
+  assert.equal(undecided.closeAcknowledgement.required, "conditional");
+  assert.match(undecided.notice, /decided at launch/u);
+  assert.ok(undecided.exception !== null);
+});
+
+test("the close acknowledgement follows the close rule: required for a caller-authored round at rigor 1 or more or in the critical profile, not at rigor 0 and low risk", () => {
+  assert.equal(describe({ runner: "codex", launchRoute: DEFAULT_ROUTE, trigger: "T3", rigor: 0 }).closeAcknowledgement.required, false);
+  assert.equal(describe({ runner: "codex", launchRoute: DEFAULT_ROUTE, trigger: "T3", rigor: 1 }).closeAcknowledgement.required, true);
+  assert.equal(describe({ runner: "codex", launchRoute: DEFAULT_ROUTE, trigger: "T3", rigor: null }).closeAcknowledgement.required, "unknown");
+  const standard = describe({ runner: "codex", launchRoute: DEFAULT_ROUTE, trigger: "T3", rigor: 1 });
+  assert.equal(standard.profile.name, "standard");
+  assert.equal(standard.profile.status, "not-critical");
+  assert.equal(standard.exception, null);
+});
+
+test("wording is never upgraded: only a source-issued, fresh-context expectation may be called independent; an unknown runner promises nothing", () => {
+  assert.equal(criticRunnerFromEnv({ CODEX_THREAD_ID: "x" }), "codex");
+  assert.equal(criticRunnerFromEnv({ CODEX_SESSION_ID: "x" }), "codex");
+  assert.equal(criticRunnerFromEnv({ ANTIGRAVITY_AGENT: "1" }), "antigravity");
+  assert.equal(criticRunnerFromEnv({ CLAUDE_CODE_SESSION_ID: "x" }), "claude");
+  assert.equal(criticRunnerFromEnv({}), "unknown");
+  const unknown = describe({ runner: "unknown" });
+  assert.equal(unknown.expected, null);
+  for (const input of [{ runner: "unknown" }, { runner: "codex" }, { runner: "codex", launchRoute: DEFAULT_ROUTE }]) {
+    const result = describe(input);
+    assert.equal(/independent/iu.test(JSON.stringify(result)), false, `no stronger word for ${JSON.stringify(input)}`);
+    assert.notEqual(result.expected?.independence, "source-issued-origin");
+  }
+  for (const input of [{ runner: "claude" }, { runner: "codex", launchRoute: SANDBOXED }]) {
+    const result = describe(input);
+    assert.deepEqual([result.expected.freshContext, result.expected.historyInherited], [true, false]);
+  }
+});
+
+test("an unreadable or unexpected input never throws and never raises the assurance", () => {
+  for (const input of [{ runner: 7 }, { runner: "codex", launchRoute: "default" }, { runner: "codex", launchRoute: { agentType: 3 } }, { runner: "claude", trigger: undefined }, { runner: "claude", packetId: "not a packet" }]) {
+    const result = describeCriticRouteAssurance(input);
+    assert.equal(result.schema, CRITIC_ROUTE_ASSURANCE_SCHEMA);
+    assert.equal(result.floor.independence, "caller-authored-fallback");
+  }
+  assert.equal(describeCriticRouteAssurance({ runner: "codex", launchRoute: "default" }).expected, null);
+  assert.equal(describeCriticRouteAssurance(undefined).expected, null);
+});
diff --git a/plugins/pipeline-core/lib/generated-artefact-schema.mjs b/plugins/pipeline-core/lib/generated-artefact-schema.mjs
new file mode 100644
index 000000000..ba221cd90
--- /dev/null
+++ b/plugins/pipeline-core/lib/generated-artefact-schema.mjs
@@ -0,0 +1,55 @@
+// SPDX-License-Identifier: SUL-1.0
+/**
+ * C22 (CGF-06, AC-108): classify the Pipeline's OWN generated metadata by a verifiable schema and keep its digest fields apart from credential fields.
+ *
+ * Measured on this repository: the secret scanner reads bare digests under key-shaped field names (`idempotencyKey`, `scopeKey`, `reuseKeySha256`, `courseKey`) of
+ * generated JSON as credentials, and every earlier answer was a path-wide ignore. This reader says, without a value ever leaving it, which fields of one file are
+ * digests whose NAME looks like a credential, and which fields really look like credentials. A class is claimed only for a JSON object with a Pipeline schema id
+ * (`pipeline.<name>.v<N>`); anything else is `unclassified` and is never excused. Pure: no I/O, no ignore list, no blanket rule, never throws. A narrow, field-scoped
+ * scanner exception for a classified file is only provable when `scannerSafe` is true (every credential-shaped name holds a bare lower-case hex digest).
+ */
+const SCHEMA_ID = /^pipeline\.[a-z0-9]+(?:[.-][a-z0-9]+)*\.v\d+$/u;
+const DIGEST = /^[0-9a-f]{32,64}$/u;
+// The name family of the scanner's generic rule (gitleaks generic-api-key): a field named like this makes it read the value as a secret.
+const CREDENTIAL_NAME = /(?:access|auth|api|credential|creds|key|passw(?:or)?d|secret|token)/iu;
+const MAX_BYTES = 4 * 1024 * 1024;
+const MAX_DEPTH = 64;
+const MIN_CREDENTIAL_LENGTH = 8;
+
+const unclassified = (reason) => Object.freeze({ class: "unclassified", schema: null, digestFields: [], keyShapedDigestFields: [], credentialFields: [], scannerSafe: false, reason });
+
+/** @param {string|Uint8Array|undefined} input the file's bytes or text */
+export function classifyGeneratedArtefact(input) {
+  try {
+    const bytes = typeof input === "string" ? Buffer.byteLength(input, "utf8") : input instanceof Uint8Array ? input.byteLength : -1;
+    if (bytes < 0) return unclassified("input is neither text nor bytes");
+    if (bytes > MAX_BYTES) return unclassified("input is larger than the bound");
+    const text = (typeof input === "string" ? input : Buffer.from(input).toString("utf8")).replace(/^﻿/u, "");
+    let value;
+    try { value = JSON.parse(text); } catch { return unclassified("not JSON"); }
+    if (value === null || typeof value !== "object" || Array.isArray(value)) return unclassified("not a JSON object");
+    if (typeof value.schema !== "string" || !SCHEMA_ID.test(value.schema)) return unclassified("no Pipeline schema id (pipeline.<name>.v<N>)");
+    const digestFields = [];
+    const keyShapedDigestFields = [];
+    const credentialFields = [];
+    let tooDeep = false;
+    const walk = (node, path, depth) => {
+      if (depth > MAX_DEPTH) { tooDeep = true; return; }
+      if (Array.isArray(node)) { node.forEach((item, index) => walk(item, `${path}[${index}]`, depth + 1)); return; }
+      if (node === null || typeof node !== "object") return;
+      for (const [name, child] of Object.entries(node)) {
+        const here = path === "" ? name : `${path}.${name}`;
+        if (typeof child === "string") {
+          const keyShaped = CREDENTIAL_NAME.test(name);
+          if (DIGEST.test(child)) { digestFields.push({ path: here, keyShaped }); if (keyShaped) keyShapedDigestFields.push(here); }
+          else if (keyShaped && child.length >= MIN_CREDENTIAL_LENGTH) credentialFields.push(here);
+        } else walk(child, here, depth + 1);
+      }
+    };
+    walk(value, "", 0);
+    if (tooDeep) return unclassified("nesting is deeper than the bound");
+    return Object.freeze({ class: "pipeline-generated", schema: value.schema, digestFields, keyShapedDigestFields, credentialFields, scannerSafe: credentialFields.length === 0, reason: null });
+  } catch {
+    return unclassified("unreadable input");
+  }
+}
diff --git a/plugins/pipeline-core/lib/generated-artefact-schema.test.mjs b/plugins/pipeline-core/lib/generated-artefact-schema.test.mjs
new file mode 100644
index 000000000..41ecb0aa2
--- /dev/null
+++ b/plugins/pipeline-core/lib/generated-artefact-schema.test.mjs
@@ -0,0 +1,61 @@
+// SPDX-License-Identifier: SUL-1.0
+// C22 (CGF-06, AC-108): criterion-bound cases for classifying the Pipeline's OWN generated metadata by a verifiable schema, with digest fields kept apart from credential fields.
+// Source: Codex greenfield report CGF-06 ("generated metadata repeatedly blocks scanners and classifiers; classify own generated artefacts by verifiable schema, separate digest from
+// credential fields; no blanket ignore, no history rewrite"). Measured on the repository: the secret scanner reads bare digests under key-shaped field names (idempotencyKey,
+// scopeKey, reuseKeySha256, courseKey) of generated JSON as credentials. Written before the module existed.
+import assert from "node:assert/strict";
+import test from "node:test";
+import { classifyGeneratedArtefact } from "./generated-artefact-schema.mjs";
+
+const HEX32 = "3f7fdf423cbf3011f758aeb70977dffc";
+const HEX64 = "a".repeat(64);
+const event = (extra = {}) => JSON.stringify({ schema: "pipeline.human-guard-event.v1", id: "evt-1", idempotencyKey: HEX32, scopeKey: HEX64, intentSha256: HEX64, ...extra });
+
+test("a generated artefact with a Pipeline schema is classified, and its key-shaped digest fields are named apart from credential fields", () => {
+  const result = classifyGeneratedArtefact(event());
+  assert.equal(result.class, "pipeline-generated");
+  assert.equal(result.schema, "pipeline.human-guard-event.v1");
+  assert.deepEqual(result.digestFields.map((field) => field.path).sort(), ["idempotencyKey", "intentSha256", "scopeKey"]);
+  assert.deepEqual(result.keyShapedDigestFields.sort(), ["idempotencyKey", "scopeKey"], "digest values whose NAME the scanner reads as a credential keyword");
+  assert.deepEqual(result.credentialFields, []);
+  assert.equal(result.scannerSafe, true, "every credential-shaped name holds a bare digest, so a field-scoped exception would be provable");
+});
+
+test("a credential-shaped field that does not hold a bare digest keeps the artefact out of the digest class: nothing is excused", () => {
+  const result = classifyGeneratedArtefact(event({ token: "not-a-digest-but-a-long-looking-value", nested: { password: HEX64.toUpperCase() } }));
+  assert.equal(result.class, "pipeline-generated");
+  assert.deepEqual(result.credentialFields.sort(), ["nested.password", "token"], "upper-case hex is not a Pipeline digest");
+  assert.equal(result.scannerSafe, false);
+});
+
+test("without a verifiable Pipeline schema the file is unclassified, never guessed from its name or its digests", () => {
+  for (const text of [JSON.stringify({ idempotencyKey: HEX32 }), JSON.stringify({ schema: "vendor.thing.v1", idempotencyKey: HEX32 }), JSON.stringify({ schema: "pipeline.x", idempotencyKey: HEX32 }),
+    "not json at all", "[1,2]", "null", JSON.stringify({ schema: 7 })]) {
+    const result = classifyGeneratedArtefact(text);
+    assert.equal(result.class, "unclassified", text);
+    assert.equal(result.scannerSafe, false);
+    assert.equal(typeof result.reason, "string");
+  }
+});
+
+test("a byte-order mark, CRLF line ends and indented text classify the same as compact text (Windows files)", () => {
+  const pretty = JSON.stringify(JSON.parse(event()), null, 2).replace(/\n/gu, "\r\n");
+  const compact = classifyGeneratedArtefact(event());
+  assert.deepEqual(classifyGeneratedArtefact(`﻿${pretty}`), compact);
+  assert.deepEqual(classifyGeneratedArtefact(Buffer.from(pretty, "utf8")), compact);
+});
+
+test("arrays and nested objects are walked with their path; the result never carries a value", () => {
+  const text = JSON.stringify({ schema: "pipeline.critic-lineage.v1", rounds: [{ packetId: HEX32, courseKey: HEX64 }] });
+  const result = classifyGeneratedArtefact(text);
+  assert.deepEqual(result.keyShapedDigestFields, ["rounds[0].courseKey"]);
+  assert.equal(JSON.stringify(result).includes(HEX64), false, "a classifier output is safe to print");
+  assert.equal(JSON.stringify(result).includes(HEX32), false);
+});
+
+test("an oversized or hostile input is refused as unclassified instead of throwing", () => {
+  assert.equal(classifyGeneratedArtefact("x".repeat(5 * 1024 * 1024)).class, "unclassified");
+  assert.equal(classifyGeneratedArtefact(undefined).class, "unclassified");
+  let deep = { schema: "pipeline.deep.v1" }; for (let index = 0; index < 200; index += 1) deep = { schema: "pipeline.deep.v1", inner: deep };
+  assert.equal(classifyGeneratedArtefact(JSON.stringify(deep)).class, "unclassified", "depth is bounded");
+});
