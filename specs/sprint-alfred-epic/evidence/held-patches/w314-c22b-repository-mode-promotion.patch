+function readTwin(root, rel) {
+  const abs = join(root, ...rel.split("/"));
+  let info;
+  try { info = lstatSync(abs); } catch (error) { if (error?.code === "ENOENT" || error?.code === "ENOTDIR") return { rel, abs, absent: true }; return { rel, abs, unsafe: true }; }
