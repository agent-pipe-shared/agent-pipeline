   const after = readCriticCourseAdmission({ ...fx.courseRequest, registrationCommit: registration, requestedMode: "delta" });
   assert.equal(after.decision.code, "CVL-COURSE-RECORD", `a forged lane must not read back as a genuine round: ${JSON.stringify(after.decision)}`);
 });
+// Appended after the numbered cases on purpose: the completion registry numbers unnumbered cases by position, so a mid-file insert would renumber the rest.
+test("N38 a manifest-only commit that changes the manifest core after the diagnostic registration is refused FPR-DELTA-TRANSPORT, and the refusal names the candidate, base and HEAD the verb chose", () => {
+  const fx = pf94DeltaFixture();
+  pf94WriteInput(fx);
+  // A reconcile-like commit: it changes only the manifest, so the candidate choice (manifest + evidence directory only) skips it as evidence-only,
+  // but it changes the manifest CORE (here feature.rigor), which the transport check refuses.
+  const manifest = JSON.parse(readFileSync(join(fx.root, fx.manifestPath), "utf8"));
+  manifest.feature.rigor = manifest.feature.rigor === 1 ? 2 : 1;
+  writeFileSync(join(fx.root, fx.manifestPath), JSON.stringify(manifest));
+  const head = pf94CommitPaths(fx.root, [fx.manifestPath], "reconcile the manifest core");
+  const actual = pf94Delta(fx);
+  assert.equal(actual.code, "FPR-DELTA-TRANSPORT", JSON.stringify(actual));
+  assert.equal(actual.candidateCommit, fx.correctionCommit, JSON.stringify(actual));
+  assert.equal(actual.baseCommit, fx.candidate, JSON.stringify(actual));
+  assert.equal(actual.headCommit, head, JSON.stringify(actual));
+  for (const sha of [fx.correctionCommit, fx.candidate, head]) assert.ok(actual.reason.includes(sha), `the refusal text names ${sha}: ${actual.reason}`);
+  assert.ok(actual.reason.includes("feature-package-reconcile"), actual.reason);
+});
 registerTestCaseCompletion({cases: completionCases, fd: 3, maxBytes: 16384});
