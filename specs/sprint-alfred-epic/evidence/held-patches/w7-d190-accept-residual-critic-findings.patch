+  gitAt("config", "user.email", "po@example.invalid");
+  gitAt("config", "user.name", "PO");
+  mkdirSync(join(root, "project"), { recursive: true });
+  writeFileSync(join(root, "project", "critical-human-proof.json"), JSON.stringify({ schema: "pipeline.critical-human-proof-policy.v1", requiredKinds: ["push", "deploy", "publication", C11_KIND] }));
