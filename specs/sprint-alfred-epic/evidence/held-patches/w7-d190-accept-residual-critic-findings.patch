+  const receipt = {
+    schema: "pipeline.session-critic-receipt.v1", packetId: "d".repeat(32), packetDigest: "e".repeat(64),
+    session: { id: "review-1", freshContext: true, historyInherited: false, mayDelegate: false },
+    candidate: { base: c11Oid("f"), ...cand }, reviewRange: { base: c11Oid("f"), commit: cand.commit, diffSha256: "1".repeat(64) },
+    rulesetSha: c11Oid("2"), assurance: "functional-equivalent-read-only; OS isolation not asserted", verdictSha256: "3".repeat(64),
+    findingCount: findings.length, reviewPass: false,
+  };
+  const packet = { packetId: receipt.packetId, candidate: { ...receipt.candidate },
+    diff: { base: receipt.reviewRange.base, commit: receipt.reviewRange.commit, sha256: receipt.reviewRange.diffSha256 } };
+  receipt.packetDigest = c11Sha(c11Canon(packet));
+  return { packet, receipt, receiptSha256: c11Sha(c11Canon(receipt)) };
+}
+
+function c11Fixture({ chat, findings, cand = candidate }) {
