     { class: "prd", path: "p", sha256: h("1"), authority: true, mutability: "mutable", retention: "active" },
diff --git a/plugins/pipeline-core/skills/close-feature/SKILL.md b/plugins/pipeline-core/skills/close-feature/SKILL.md
index bc5ebf05d..25ef7d304 100644
--- a/plugins/pipeline-core/skills/close-feature/SKILL.md
