+const own=dirname(fileURLToPath(import.meta.url));
+const pluginRoot=process.argv[2]?resolve(process.argv[2]):fileURLToPath(new URL('../',import.meta.url));
+const mod=await import(pathToFileURL(join(pluginRoot,'hooks/guard-dispatch-budget.mjs')));
+const darwin=await import(pathToFileURL(join(pluginRoot,'lib/darwin-native-process-observer.mjs')));
+const windows=await import(pathToFileURL(join(pluginRoot,'lib/windows-native-process-observer.mjs')));
+const dir=process.argv[3]?resolve(process.argv[3]):join(pluginRoot,'../../scratch/darwin-platform-owner-fixtures');mkdirSync(dir,{recursive:true});
+const a='a'.repeat(64),b='b'.repeat(64);
+const processFact=(platform,pid,start=platform==='darwin'?'2000000000:123456':'638000000000000000',boot=platform==='darwin'?a:'win32-boot-637000000000000000')=>({platform,pid,start,...(platform==='darwin'?{bootSha256:boot}:{bootIdentity:boot})});
+const base=platform=>({platform,pid:12345,hostnameFn:()=> 'fixture-host',epochNowFn:()=>2000000000000,uptimeFn:()=>1000,processUptimeFn:()=>10,killFn:()=>{},observeCounterLockProcessFn:(pid)=>({status:'present',process:processFact(platform,pid)})});
+function path(name){return join(dir,name+'.lock');}
+function seed(name,platform,changes={}){const p=path(name),fact=processFact(platform,12346);const owner={platform,hostId:'fixture-host',bootId:platform==='darwin'?'darwin-boot-'+fact.bootSha256:fact.bootIdentity,pid:fact.pid,processStart:fact.start,nonce:'a'.repeat(32),...changes};writeFileSync(p,JSON.stringify({schema:'pipeline.dispatch-budget-counter-lock.v1',owner})+'\n');return {path:p,bytes:readFileSync(p),ino:lstatSync(p).ino};}
+function preserved(h){assert.deepEqual(readFileSync(h.path),h.bytes);assert.equal(lstatSync(h.path).ino,h.ino);}
+for(const platform of ['darwin','win32']){
+ test(platform+' immutable native tuple uncontended acquire/release (injected)',()=>{const p=path(platform+'-new'),r=mod.acquireDispatchBudgetCounterLock(p,base(platform));assert.equal(r.status,'acquired');const owner=JSON.parse(readFileSync(p)).owner;assert.equal(owner.processStart,processFact(platform,12345).start);assert.equal(mod.releaseDispatchBudgetCounterLock(r.lock),true);});
+ test(platform+' matching foreign-PID tuple remains live, unchanged (injected)',()=>{const h=seed(platform+'-live',platform);assert.equal(mod.acquireDispatchBudgetCounterLock(h.path,base(platform)).code,'counter-lock-busy');preserved(h);});
+ test(platform+' reused live foreign PID different immutable start recovers (injected)',()=>{const h=seed(platform+'-reuse',platform);const d={...base(platform),observeCounterLockProcessFn:pid=>({status:'present',process:processFact(platform,pid,pid===12346?(platform==='darwin'?'2000000001:123456':'638000000000000001'):undefined)})};const r=mod.acquireDispatchBudgetCounterLock(h.path,d);assert.equal(r.status,'acquired');assert.equal(r.recovered,true);assert.equal(mod.releaseDispatchBudgetCounterLock(r.lock),true);});
+ test(platform+' absent owner recovers (injected)',()=>{const h=seed(platform+'-absent',platform);const d={...base(platform),observeCounterLockProcessFn:pid=>pid===12346?{status:'absent'}:{status:'present',process:processFact(platform,pid)}};const r=mod.acquireDispatchBudgetCounterLock(h.path,d);assert.equal(r.status,'acquired');assert.equal(r.recovered,true);assert.equal(mod.releaseDispatchBudgetCounterLock(r.lock),true);});
+ test(platform+' changed current boot recovers old same-host owner (injected)',()=>{const h=seed(platform+'-boot',platform);const boot=platform==='darwin'?b:'win32-boot-637000000000000001';const d={...base(platform),observeCounterLockProcessFn:pid=>({status:'present',process:processFact(platform,pid,undefined,boot)})};const r=mod.acquireDispatchBudgetCounterLock(h.path,d);assert.equal(r.status,'acquired');assert.equal(r.recovered,true);assert.equal(mod.releaseDispatchBudgetCounterLock(r.lock),true);});
+ for(const [label,observer] of [['unavailable',()=>({status:'unavailable',code:'denied'})],['unknown',()=>({status:'unknown'})],['wrong-pid',pid=>({status:'present',process:processFact(platform,pid+1)})],['malformed',pid=>({status:'present',process:processFact(platform,pid,'bad')})]])test(platform+' '+label+' remains ambiguous and intact (injected)',()=>{const h=seed(platform+'-'+label,platform);const d={...base(platform),observeCounterLockProcessFn:pid=>pid===12345?{status:'present',process:processFact(platform,pid)}:observer(pid)};assert.equal(mod.acquireDispatchBudgetCounterLock(h.path,d).code,'counter-lock-owner-ambiguous');preserved(h);});
+ test(platform+' foreign host and platform preserve bytes (injected)',()=>{const h=seed(platform+'-foreign',platform,{hostId:'other-host'});assert.equal(mod.acquireDispatchBudgetCounterLock(h.path,base(platform)).code,'counter-lock-owner-ambiguous');preserved(h);const d={...base(platform),platform:platform==='darwin'?'win32':'darwin'};assert.equal(mod.acquireDispatchBudgetCounterLock(h.path,d).code,'counter-lock-owner-ambiguous');preserved(h);});
+ test(platform+' live owner wait shares one deadline and never steals (injected)',()=>{const h=seed(platform+'-wait',platform);let clock=100,deadlines=[];const d={...base(platform),now:()=>clock,sleep:ms=>clock+=ms,observeCounterLockProcessFn:(pid,options)=>{assert.ok(options?.deadlineMs>=0);deadlines.push(options.deadlineMs);return {status:'present',process:processFact(platform,pid)};}};const r=mod.acquireDispatchBudgetCounterLockWithWait(h.path,d);assert.equal(r.code,'counter-lock-timeout');assert.equal(clock,3100);assert.ok(deadlines.length>1);assert.equal(new Set(deadlines).size,1);preserved(h);});
+ test(platform+' live released during wait acquires without recovery (injected)',()=>{const h=seed(platform+'-release',platform);let clock=0,removed=false;const d={...base(platform),now:()=>clock,sleep:ms=>{clock+=ms;if(!removed){unlinkSync(h.path);removed=true;}}};const r=mod.acquireDispatchBudgetCounterLockWithWait(h.path,d);assert.equal(r.status,'acquired');assert.equal(r.recovered,false);assert.equal(mod.releaseDispatchBudgetCounterLock(r.lock),true);});
+ test(platform+' noncanonical persisted tuple remains malformed (injected)',()=>{const h=seed(platform+'-bad-start',platform,{processStart:platform==='darwin'?'02000000000:123456':'0638000000000000000'});assert.equal(mod.acquireDispatchBudgetCounterLock(h.path,base(platform)).code,'counter-lock-malformed');preserved(h);});
+}
+test('legacy win32 approximate tuple remains ambiguous when its PID is present',()=>{const h=seed('win32-legacy','win32',{bootId:'w32boot-1999999000',processStart:'1999999990'});assert.equal(mod.acquireDispatchBudgetCounterLock(h.path,base('win32')).code,'counter-lock-owner-ambiguous');preserved(h);});
+test('legacy win32 tuple can recover proven absent PID',()=>{const h=seed('win32-legacy-absent','win32',{bootId:'w32boot-1999999000',processStart:'1999999990'});const d={...base('win32'),observeCounterLockProcessFn:pid=>pid===12346?{status:'absent'}:{status:'present',process:processFact('win32',pid)}};const r=mod.acquireDispatchBudgetCounterLock(h.path,d);assert.equal(r.status,'acquired');assert.equal(r.recovered,true);assert.equal(mod.releaseDispatchBudgetCounterLock(r.lock),true);});
+test('native adapters reject expired shared deadline without spawning or issuing native facts',()=>{const options={deadlineMs:performance.now()-1};assert.equal(darwin.observeNativeDarwinProcess({pid:process.pid},options).code,'darwin-observer-deadline');assert.equal(windows.observeNativeWindowsProcess({pid:process.pid},options).reason,'WPO-DEADLINE');});
+test('native adapters never accept injected platform as native proof',()=>{if(process.platform==='linux'){assert.equal(darwin.observeNativeDarwinProcess({pid:process.pid}).status,'unavailable');assert.equal(windows.observeNativeWindowsProcess({pid:process.pid}).status,'unavailable');}});
