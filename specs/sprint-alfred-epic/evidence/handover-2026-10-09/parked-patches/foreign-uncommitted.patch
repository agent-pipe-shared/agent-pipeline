+// submit-plan resolves the onboarding intake scope through `git rev-parse --git-common-dir`; outside a
+// repository that throws and the fail-closed catch reports PROFILE-AUTHORITY-INVALID. Directories that reach
+// submit-plan are made repositories here, never in freshDir (PS11 and close-feature-git-error need a non-Git dir).
+function initFixtureGitRepoForSubmitPlan(dir) {
+  if (existsSync(join(dir, ".git"))) return;
+  const git = (...args) => spawnSync("git", args, { cwd: dir, encoding: "utf8" });
+  const initialized = git("init", "-q");
+  if (initialized.status !== 0) throw new Error(`fixture git init failed: ${initialized.stderr}`);
+  git("config", "user.email", "goldfish@example.invalid");
+  git("config", "user.name", "Goldfish");
+  git("commit", "-q", "--allow-empty", "-m", "init");
+}
+
 function submitAndApprove(dir, planPath) {
+  initFixtureGitRepoForSubmitPlan(dir);
   const activeFeature = readState(dir).state.activeFeature;
   const initialized = initializeLifecycleContinuity(dir, activeFeature.id, planPath);
   const deps = lifecycleDeps(dir, planPath);
