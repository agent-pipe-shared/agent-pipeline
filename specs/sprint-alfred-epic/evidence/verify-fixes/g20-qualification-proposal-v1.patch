new file mode 100644
index 000000000..8d25cd29c
--- /dev/null
+++ b/plugins/pipeline-core/lib/publication-review-requirement.mjs
@@ -0,0 +1,13 @@
+// SPDX-License-Identifier: SUL-1.0
+/** A submitted mini/feature/epic profile carries rigor >= 1. */
+export function requiresPublicationReview(state) {
+  const profiles = new Set(["mini", "feature", "epic"]);
+  if (profiles.has(state?.planSubmission?.profile)) return true;
+  // close-feature removes planSubmission and activeFeature, but retains the
+  // feature's rigor floor in the journal and its identity in closedFeatures.
+  const latestClosed = Array.isArray(state?.closedFeatures) ? state.closedFeatures.at(-1) : null;
+  const featureId = state?.activeFeature?.id ?? latestClosed?.id;
+  return typeof featureId === "string" && Array.isArray(state?.rigorHistory)
+    && state.rigorHistory.some((row) => row?.body?.featureId === featureId
+      && profiles.has(row?.body?.observation?.retainedProfile));
+}
