new file mode 100644
index 000000000..09192111c
--- /dev/null
+++ b/plugins/pipeline-core/scripts/codex-critic-baseline.test.mjs
@@ -0,0 +1,41 @@
+// SPDX-License-Identifier: SUL-1.0
+import assert from "node:assert/strict";
+import { test } from "node:test";
+import { execFileSync } from "node:child_process";
+import { mkdirSync, mkdtempSync, rmSync, writeFileSync } from "node:fs";
+import { join } from "node:path";
+import { captureRepositoryFingerprint, assertNativeCriticChildStartUnchanged } from "./codex-critic-host.mjs";
+
+const git = (cwd, ...args) => execFileSync("git", args, { cwd, stdio: "pipe" });
+
+test("full child-start fingerprint permits prior host reservation and refuses subsequent Git mutations", () => {
+  const scratch = join(process.cwd(), "scratch", "g17-baseline-fixtures");
+  mkdirSync(scratch, { recursive: true });
+  const root = mkdtempSync(join(scratch, "repo-"));
+  try {
+    git(root, "init", "-q");
+    writeFileSync(join(root, "tracked.txt"), "base\n");
+    git(root, "add", "--", "tracked.txt");
+    git(root, "-c", "user.name=Fixture", "-c", "user.email=fixture@example.invalid", "commit", "-qm", "base");
+    const fingerprint = () => ({ candidate: captureRepositoryFingerprint(root).sha256 });
+    const prepared = fingerprint();
+    const registry = join(root, ".git", "agent-pipeline", "session-authority");
+    mkdirSync(registry, { recursive: true });
+    writeFileSync(join(registry, "reservation.json"), "host reservation\n");
+    const childStart = fingerprint();
+    assert.notDeepEqual(childStart, prepared, "a host reservation changes the prepare fingerprint");
+    assert.doesNotThrow(() => assertNativeCriticChildStartUnchanged(childStart, fingerprint()));
+    const changes = [
+      () => writeFileSync(join(registry, "child.json"), "child write\n"),
+      () => writeFileSync(join(root, "tracked.txt"), "worktree mutation\n"),
+      () => git(root, "add", "--", "tracked.txt"),
+      () => git(root, "-c", "user.name=Fixture", "-c", "user.email=fixture@example.invalid", "commit", "-qm", "child commit"),
+    ];
+    for (const change of changes) {
+      change();
+      assert.throws(() => assertNativeCriticChildStartUnchanged(childStart, fingerprint()), /repository mutation observed/);
+    }
+  } finally {
+    rmSync(root, { recursive: true, force: true });
+  }
+});
