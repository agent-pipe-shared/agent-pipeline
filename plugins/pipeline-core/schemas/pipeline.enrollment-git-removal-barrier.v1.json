{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pipeline.enrollment-git-removal-barrier.v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "root",
    "rootIdentity",
    "planSha256",
    "phase"
  ],
  "properties": {
    "schema": {
      "const": "pipeline.enrollment-git-removal-barrier.v1"
    },
    "root": {
      "type": "string"
    },
    "rootIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dev",
        "ino"
      ],
      "properties": {
        "dev": {
          "type": "string",
          "pattern": "^[0-9]+$"
        },
        "ino": {
          "type": "string",
          "pattern": "^[0-9]+$"
        }
      }
    },
    "planSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "phase": {
      "enum": [
        "requested",
        "created",
        "retired"
      ]
    }
  }
}
