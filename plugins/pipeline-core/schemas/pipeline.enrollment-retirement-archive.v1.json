{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pipeline.enrollment-retirement-archive.v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "root",
    "rootIdentity",
    "commonIdentity",
    "scopeKey",
    "barrierSha256",
    "priorGenerationSha256",
    "by",
    "at",
    "entries",
    "generationSha256"
  ],
  "properties": {
    "schema": {
      "const": "pipeline.enrollment-retirement-archive.v1"
    },
    "root": {
      "type": "string"
    },
    "rootIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dev",
        "ino"
      ],
      "properties": {
        "dev": {
          "type": "string",
          "pattern": "^[0-9]+$"
        },
        "ino": {
          "type": "string",
          "pattern": "^[0-9]+$"
        }
      }
    },
    "commonIdentity": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "dev",
            "ino"
          ],
          "properties": {
            "dev": {
              "type": "string",
              "pattern": "^[0-9]+$"
            },
            "ino": {
              "type": "string",
              "pattern": "^[0-9]+$"
            }
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "scopeKey": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "barrierSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "priorGenerationSha256": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "by": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "at": {
      "type": "string",
      "format": "date-time"
    },
    "entries": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "slot",
          "path",
          "sha256",
          "byteLength",
          "bytesBase64",
          "identity"
        ],
        "properties": {
          "slot": {
            "enum": [
              "state",
              "intake",
              "consent"
            ]
          },
          "path": {
            "type": "string",
            "maxLength": 4096
          },
          "sha256": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "byteLength": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1048576
          },
          "bytesBase64": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "identity": {
            "anyOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "dev",
                  "ino"
                ],
                "properties": {
                  "dev": {
                    "type": "string",
                    "pattern": "^[0-9]+$"
                  },
                  "ino": {
                    "type": "string",
                    "pattern": "^[0-9]+$"
                  }
                }
              },
              {
                "type": "null"
              }
            ]
          }
        }
      }
    },
    "generationSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
