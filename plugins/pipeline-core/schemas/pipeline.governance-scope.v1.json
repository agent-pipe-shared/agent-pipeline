{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pipeline.governance-scope.v1",
  "title": "Observed local repository activation; no implementation authority",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "state", "root", "scopeKey", "repositoryKind", "provenance", "diagnostics", "requiresEnforcement", "hintAllowed"],
  "properties": {
    "schema": {"const": "pipeline.governance-scope.v1"},
    "state": {"enum": ["active", "inactive", "declined", "unverifiable-active"]},
    "root": {"type": ["string", "null"]},
    "scopeKey": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
    "repositoryKind": {"enum": ["git", "non-git", "unavailable"]},
    "provenance": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "refs"],
      "properties": {
        "kind": {"enum": ["none", "explicit-local-decision", "existing-consent", "legacy-v3-intent", "legacy-v3-owned-projection", "legacy-paired-authority", "untrusted-config"]},
        "refs": {"type": "array", "maxItems": 4, "items": {"type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": {"path": {"type": "string", "minLength": 1, "maxLength": 512}, "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}}}
      }
    },
    "diagnostics": {"type": "array", "maxItems": 4, "items": {"type": "string", "pattern": "^GS-[A-Z0-9-]+$"}},
    "requiresEnforcement": {"type": "boolean"},
    "hintAllowed": {"type": "boolean"}
  },
  "$defs": {
    "identity": {"type": "object", "additionalProperties": false, "required": ["dev", "ino"], "properties": {"dev": {"type": "string", "pattern": "^[0-9]+$"}, "ino": {"type": "string", "pattern": "^[0-9]+$"}}},
    "decisionPlan": {
      "type": "object", "additionalProperties": false,
      "required": ["schema", "root", "scopeKey", "repositoryKind", "rootIdentity", "commonIdentity", "decision", "by", "preimageSha256", "planSha256"],
      "properties": {
        "schema": {"const": "pipeline.governance-decision-plan.v1"},
        "root": {"type": "string", "minLength": 1},
        "scopeKey": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "repositoryKind": {"enum": ["git", "non-git"]},
        "rootIdentity": {"$ref": "#/$defs/identity"},
        "commonIdentity": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/identity"}]},
        "decision": {"enum": ["enroll", "decline"]},
        "by": {"type": "string", "minLength": 1, "maxLength": 256},
        "preimageSha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
        "planSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "enrollment": {
      "type": "object", "additionalProperties": false,
      "required": ["schema", "root", "rootIdentity", "commonIdentity", "scopeKey", "state", "by", "decidedAt"],
      "properties": {
        "schema": {"const": "pipeline.governance-enrollment.v1"},
        "root": {"type": "string", "minLength": 1},
        "rootIdentity": {"$ref": "#/$defs/identity"},
        "commonIdentity": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/identity"}]},
        "scopeKey": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "state": {"enum": ["active", "declined"]},
        "by": {"type": "string", "minLength": 1, "maxLength": 256},
        "decidedAt": {"type": "string", "format": "date-time"}
      }
    }
  }
}
