          "required": true,
          "sensitivity": "public",
          "prompt": "Approved plan path"
        },
        {
          "name": "spec",
          "type": "repo-relative-path",
          "source": "repository-observation",
          "required": true,
          "sensitivity": "public",
          "prompt": "Bound specification path"
        },
        {
          "name": "subjectSha256",
          "type": "sha256",
          "source": "tool-result",
          "required": true,
          "sensitivity": "public",
          "prompt": "Prepared push subject digest"
        },
        {
          "name": "expiresAt",
          "type": "iso8601",
          "source": "tool-result",
          "required": true,
          "sensitivity": "public",
          "prompt": "Approval expiry"
        },
        {
          "name": "launcher",
          "type": "absolute-file",
          "source": "tool-result",
          "required": false,
          "sensitivity": "machine-private",
          "prompt": "Installed approval driver"
        }
      ],
      "expectedReadback": {
        "schema": null,
        "code": "PO-HUMAN-CRITICAL-AUTHORIZATION-READY",
        "command": "verify-critical"
      },
      "runners": [
