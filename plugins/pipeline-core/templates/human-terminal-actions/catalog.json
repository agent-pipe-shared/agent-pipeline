      "slots": [
        {
          "name": "repoRoot",
          "type": "absolute-directory",
          "source": "repository-observation",
          "required": true,
          "sensitivity": "public",
          "prompt": "Repository root"
        },
        {
          "name": "directory",
          "type": "absolute-directory",
          "source": "human-input",
          "required": true,
          "sensitivity": "machine-private",
          "prompt": "External PO material directory"
        },
        {
          "name": "featureId",
