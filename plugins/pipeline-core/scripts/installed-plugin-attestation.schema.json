{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pipeline.installed-plugin-attestation.v1",
  "title": "Structural schema for an installer-owned installed plugin attestation",
  "description": "Validates the portable JSON structure only. The installed-plugin-attestation runtime verifier is authoritative for semantic constraints that JSON Schema cannot express, including ascending protected-file path order and uniqueness by path key.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "receiptId", "provider", "plugin", "installed", "source", "protected"],
  "properties": {
    "schema": { "const": "pipeline.installed-plugin-attestation.v1" },
    "receiptId": { "$ref": "#/$defs/sha256" },
    "provider": { "$ref": "#/$defs/id" },
    "plugin": {
      "type": "object", "additionalProperties": false, "required": ["name", "version"],
      "properties": { "name": { "$ref": "#/$defs/id" }, "version": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9.+_-]{0,127}$" } }
    },
    "installed": {
      "type": "object", "additionalProperties": false,
      "required": ["physicalRootPathSha256", "physicalRootIdentitySha256", "contentSha256"],
      "properties": { "physicalRootPathSha256": { "$ref": "#/$defs/sha256" }, "physicalRootIdentitySha256": { "$ref": "#/$defs/sha256" }, "contentSha256": { "$ref": "#/$defs/sha256" } }
    },
    "source": { "oneOf": [
      { "type": "object", "additionalProperties": false, "required": ["class", "repository", "branch", "commit", "tree"], "properties": { "class": { "const": "local-development" }, "repository": { "type": "string", "minLength": 1 }, "branch": { "type": "string", "minLength": 1 }, "commit": { "$ref": "#/$defs/oid" }, "tree": { "$ref": "#/$defs/oid" } } },
      { "type": "object", "additionalProperties": false, "required": ["class", "envelope"], "properties": { "class": { "const": "signed-release" }, "envelope": { "$ref": "#/$defs/provenanceEnvelope" } } }
    ] },
    "protected": {
      "type": "object", "additionalProperties": false, "required": ["graphSha256", "files"],
      "properties": {
        "graphSha256": { "$ref": "#/$defs/sha256" },
        "files": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "description": "Protected file entries. JSON Schema enforces whole-item uniqueness; the authoritative runtime verifier additionally enforces ascending code-point path order and uniqueness by path key.",
          "items": {
            "type": "object", "additionalProperties": false, "required": ["path", "sha256"],
            "properties": {
              "path": { "type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)(?!.*\\u0000)[^\\r\\n]+$" },
              "sha256": { "$ref": "#/$defs/sha256" }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "oid": { "type": "string", "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$" },
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$" },
    "provenanceEnvelope": {
      "type": "object", "additionalProperties": false,
      "required": ["schema", "candidate", "subject", "materials", "builder", "invocation", "environment", "assurance", "attestation", "reproducibility"],
      "properties": {
        "schema": { "const": "pipeline.provenance-envelope.v1" },
        "candidate": { "type": "object", "additionalProperties": false, "required": ["commit", "tree"], "properties": { "commit": { "$ref": "#/$defs/oid" }, "tree": { "$ref": "#/$defs/oid" } } },
        "subject": { "type": "object", "additionalProperties": false, "required": ["id", "sha256"], "properties": { "id": { "type": "string", "minLength": 1 }, "sha256": { "$ref": "#/$defs/sha256" } } },
        "materials": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["id", "kind", "sha256"], "properties": { "id": { "type": "string", "minLength": 1 }, "kind": { "type": "string", "minLength": 1 }, "sha256": { "$ref": "#/$defs/sha256" } } } },
        "builder": { "type": "object", "additionalProperties": false, "required": ["id", "digest"], "properties": { "id": { "type": "string", "minLength": 1 }, "digest": { "$ref": "#/$defs/sha256" } } },
        "invocation": { "type": "object", "additionalProperties": false, "required": ["id", "parametersSha256"], "properties": { "id": { "type": "string", "minLength": 1 }, "parametersSha256": { "$ref": "#/$defs/sha256" } } },
        "environment": { "type": "object", "additionalProperties": false, "required": ["kind", "identitySha256"], "properties": { "kind": { "type": "string", "minLength": 1 }, "identitySha256": { "$ref": "#/$defs/sha256" } } },
        "assurance": { "enum": ["unverified", "verified"] },
        "attestation": { "type": "object", "additionalProperties": false, "required": ["keyReference", "signatureSha256", "status"], "properties": { "keyReference": { "type": "string", "minLength": 1 }, "signatureSha256": { "$ref": "#/$defs/sha256" }, "status": { "enum": ["verified", "unverified", "revoked", "expired"] } } },
        "reproducibility": { "enum": ["not-assessed", "non-reproducible-expected", "repeatable-in-same-builder", "reproducible-in-independent-builder", "hermetic-evidence-available", "mismatch", "unverifiable"] }
      }
    }
  }
}
