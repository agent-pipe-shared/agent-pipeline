{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pipeline.repair-map.v1",
  "title": "Guard-union refusal repair map: liftable, by whom, and the exact command, asked at runtime",
  "type": "object",
  "required": ["schema", "generatedAt", "enumerationSource", "knownEligibilityCodes", "uncoveredEligibilityCodes", "rows"],
  "additionalProperties": false,
  "properties": {
    "schema": { "type": "string", "enum": ["pipeline.repair-map.v1"] },
    "generatedAt": { "type": "string", "format": "date-time" },
    "enumerationSource": { "type": "string", "minLength": 1 },
    "knownEligibilityCodes": { "type": "array", "items": { "type": "string" } },
    "uncoveredEligibilityCodes": { "type": "array", "items": { "type": "string" } },
    "rows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["code", "liftable", "by", "command", "reason"],
        "additionalProperties": true,
        "properties": {
          "code": { "type": "string", "minLength": 1 },
          "liftable": {
            "type": "string",
            "enum": ["in-session-or-signed", "narrower-recovery", "author-repair-required", "never", "unknown"]
          },
          "by": {
            "type": "string",
            "enum": ["this-session-human", "attended-operator-outside-session", "attended-author-outside-session", "nobody", "unknown"]
          },
          "command": {
            "type": ["array", "null"],
            "items": {
              "type": "object",
              "required": ["executable", "argv"],
              "additionalProperties": false,
              "properties": {
                "executable": { "type": "string", "minLength": 1 },
                "argv": { "type": "array", "items": { "type": "string" } }
              }
            }
          },
          "reason": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
