{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pipeline.backlog-spec-binding.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "featureId",
    "specification",
    "backlogSnapshot",
    "bindings",
    "recordSha256"
  ],
  "properties": {
    "schema": {
      "const": "pipeline.backlog-spec-binding.v1"
    },
    "featureId": {
      "type": "string",
      "maxLength": 128
    },
    "specification": {
      "$ref": "#/$defs/specification"
    },
    "backlogSnapshot": {
      "$ref": "#/$defs/snapshot"
    },
    "bindings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/binding"
      }
    },
    "recordSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "$defs": {
    "specification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "maxLength": 512
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "commit",
        "tree",
        "backlogSubtree",
        "ledgerHead",
        "indexFileSha256",
        "statusFileSha256",
        "itemFileSha256"
      ],
      "properties": {
        "commit": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "tree": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "backlogSubtree": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "ledgerHead": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "indexFileSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "statusFileSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "itemFileSha256": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/itemDigest"
          }
        }
      }
    },
    "itemDigest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "sha256"
      ],
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "binding": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "issue",
            "increment",
            "acceptanceIds",
            "closureMode",
            "expiryDisposition"
          ],
          "properties": {
            "id": {
              "type": "string",
              "maxLength": 128
            },
            "issue": {
              "type": "integer"
            },
            "increment": {
              "enum": [
                "A",
                "B"
              ]
            },
            "acceptanceIds": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string"
              }
            },
            "closureMode": {
              "enum": [
                "candidate-evidence",
                "separate-pilot-required",
                "cyborg-input-only",
                "later-sprint-input-only"
              ]
            },
            "expiryDisposition": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "issue",
            "increment",
            "acceptanceIds",
            "closureMode",
            "expiryDisposition",
            "poWithdrawal"
          ],
          "properties": {
            "id": {
              "const": "pipeline.multi-cli-efficiency-pilots"
            },
            "issue": {
              "const": 8
            },
            "increment": {
              "const": "A"
            },
            "acceptanceIds": {
              "type": "array",
              "minItems": 1,
              "contains": {
                "const": "NVA-A8-5"
              },
              "items": {
                "type": "string"
              }
            },
            "closureMode": {
              "const": "po-withdrawn-scope"
            },
            "expiryDisposition": {
              "const": "not-applicable"
            },
            "poWithdrawal": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "itemPath",
                "sourceCommit",
                "sourceSha256",
                "ledgerSequence",
                "ledgerEntryHash"
              ],
              "properties": {
                "itemPath": {
                  "const": "backlog/items/2026-07-20-multi-cli-efficiency-pilots.md"
                },
                "sourceCommit": {
                  "const": "f98f05b52635a172526407d3a5e99490dca8104c"
                },
                "sourceSha256": {
                  "const": "7a0f0cfa653a76f9205f3373da19dcec75be21c0bc0679d98feff90e46d6c264"
                },
                "ledgerSequence": {
                  "const": 793
                },
                "ledgerEntryHash": {
                  "const": "c43cb511d0c6dd6ce2e846162c3b56ec8ec5ab3231b27e48b03f8f68e958b4d7"
                }
              }
            }
          }
        }
      ]
    }
  }
}
