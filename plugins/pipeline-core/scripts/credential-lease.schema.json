{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pipeline.credential-lease.v1",
  "$comment": "Runtime validation in credential-lease.mjs additionally enforces canonical lexical array order and expiresAt > issuedAt, which JSON Schema 2020-12 cannot express across sibling instance values.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "leaseId", "broker", "subjectSha256", "repository", "operations", "targets", "issuedAt", "expiresAt", "revocationHandleSha256", "credentialClass", "status", "readbackSha256", "recordSha256"],
  "properties": {
    "schema": {"const": "pipeline.credential-lease.v1"},
    "leaseId": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "broker": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "subjectSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "repository": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "operations": {"type": "array", "minItems": 1, "maxItems": 256, "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"}},
    "targets": {"type": "array", "minItems": 1, "maxItems": 256, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-f0-9]{64}$"}},
    "issuedAt": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
    "expiresAt": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
    "revocationHandleSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "credentialClass": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "assumptions", "assumptionDisposition"],
      "properties": {
        "kind": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
        "assumptionDisposition": {"enum": ["paused", "failed"]},
        "assumptions": {
          "type": "object",
          "additionalProperties": false,
          "required": ["assumptionSetId", "subjectSha256", "assumptions", "issuedBy", "issuedAt", "expiresAt", "stopConditions", "escalation", "forbiddenAuthorities", "recordSha256"],
          "properties": {
            "assumptionSetId": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
            "subjectSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
            "assumptions": {"type": "array", "maxItems": 256, "uniqueItems": true, "items": {"type": "object", "additionalProperties": false, "required": ["name", "value", "source"], "properties": {"name": {"type": "string", "minLength": 1, "maxLength": 256}, "value": {"type": "string", "minLength": 1, "maxLength": 256}, "source": {"type": "string", "minLength": 1, "maxLength": 256}}}},
            "issuedBy": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
            "issuedAt": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
            "expiresAt": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
            "stopConditions": {"type": "array", "maxItems": 256, "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"}},
            "escalation": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
            "forbiddenAuthorities": {"type": "array", "minItems": 6, "maxItems": 6, "uniqueItems": true, "items": {"enum": ["delegation", "approval", "credential-issuance", "external-mutation", "merge", "release"]}},
            "recordSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
          }
        }
      }
    },
    "status": {"enum": ["issued", "active", "revoked", "expired", "unknown"]},
    "readbackSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "recordSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
