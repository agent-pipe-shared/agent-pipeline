{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-pipeline.dev/schemas/installed-plugin-source-locator.schema.json",
  "title": "Restricted host-owned local-development source locator",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "provider", "plugin", "installedRootPathSha256", "sourcePluginRoot", "sourcePluginRootSha256"],
  "properties": {
    "schema": { "const": "pipeline.installed-plugin-source-locator.v1" },
    "provider": { "enum": ["codex", "claude", "antigravity"] },
    "plugin": {
      "type": "object", "additionalProperties": false, "required": ["name", "version"],
      "properties": { "name": { "const": "pipeline-core" }, "version": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9.+_-]{0,127}$" } }
    },
    "installedRootPathSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "sourcePluginRoot": { "type": "string", "minLength": 1, "maxLength": 4096 },
    "sourcePluginRootSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
