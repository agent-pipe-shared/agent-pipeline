{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "pipeline.publication-executor-result.v2",
  "type": "object", "additionalProperties": false,
  "required": ["schema", "status", "code", "channel", "transactionId", "destinationDigest", "destinationRef", "candidateOid", "candidateTree", "authorityRawSha256", "publicationReceiptDigest", "executorSha256", "pushAttempted", "readback", "receiptSha256"],
  "properties": {
    "schema": {"const": "pipeline.publication-executor-result.v2"}, "status": {"enum": ["closed", "reapproval-required", "blocked-recovery"]},
    "code": {"enum": ["PX-CLOSED", "PX-REAPPROVAL-REQUIRED", "PX-BLOCKED-RECOVERY"]}, "channel": {"enum": ["private", "neutral-public"]},
    "transactionId": {"type": "string", "pattern": "^[A-Za-z0-9._:@/-]{1,200}$"}, "destinationDigest": {"$ref": "#/$defs/digest"},
    "destinationRef": {"type": "string", "pattern": "^refs/heads/[A-Za-z0-9._/-]+$"}, "candidateOid": {"$ref": "#/$defs/oid"}, "candidateTree": {"$ref": "#/$defs/oid"},
    "authorityRawSha256": {"$ref": "#/$defs/digest"}, "publicationReceiptDigest": {"oneOf": [{"$ref": "#/$defs/digest"}, {"type": "null"}]},
    "executorSha256": {"$ref": "#/$defs/digest"}, "pushAttempted": {"type": "boolean"},
    "readback": {"type": "object", "additionalProperties": false, "required": ["repositoryKind", "alternatesDisabled", "oid", "tree"], "properties": {"repositoryKind": {"const": "fresh-disposable"}, "alternatesDisabled": {"const": true}, "oid": {"oneOf": [{"$ref": "#/$defs/oid"}, {"type": "null"}]}, "tree": {"oneOf": [{"$ref": "#/$defs/oid"}, {"type": "null"}]}}},
    "receiptSha256": {"$ref": "#/$defs/digest"}
  },
  "allOf": [{"if": {"properties": {"status": {"const": "closed"}}}, "then": {"properties": {"code": {"const": "PX-CLOSED"}, "publicationReceiptDigest": {"$ref": "#/$defs/digest"}}}, "else": {"properties": {"publicationReceiptDigest": {"type": "null"}}}}],
  "$defs": {"digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "oid": {"type": "string", "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"}}
}
