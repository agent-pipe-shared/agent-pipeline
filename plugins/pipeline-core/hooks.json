{
  "pipeline-core": {
    "enabled": true,
    "PreToolUse": [
      {
        "matcher": "run_command|write_to_file|replace_file_content|invoke_subagent",
        "hooks": [
          {
            "type": "command",
            "command": "node hooks/antigravity-slicing-hint.mjs observe",
            "timeout": 3
          },
          {
            "type": "command",
            "command": "node hooks/antigravity-pretool-guard.mjs",
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "node hooks/antigravity-stop-hook.mjs",
        "timeout": 15
      }
    ],
    "PreInvocation": [
      {
        "type": "command",
        "command": "node hooks/antigravity-slicing-hint.mjs deliver",
        "timeout": 3
      },
      {
        "type": "command",
        "command": "node hooks/antigravity-start-hint.mjs",
        "timeout": 5
      }
    ]
  }
}
