{
  "pipeline-core": {
    "enabled": true,
    "PreToolUse": [
      {
        "matcher": "run_command|write_to_file|replace_file_content|invoke_subagent",
        "hooks": [
          {
            "type": "command",
            "command": "echo \"plugin hook ran\" >> /tmp/plugin-hook.log && node \"hooks/antigravity-pretool-guard.mjs\"",
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"hooks/antigravity-stop-hook.mjs\"",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
