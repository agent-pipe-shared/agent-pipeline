# Normalize line endings (cross-OS clone: Windows-authored, macOS/Linux consumed).
* text=auto eol=lf
*.mjs text eol=lf
*.js text eol=lf
*.json text eol=lf
evidence/design-course/sprint-alfred-epic/r5d.package.json -text
evidence/design-course/sprint-alfred-epic/r5d.readiness.json -text
evidence/design-course/sprint-alfred-epic/claude-r5d.failure.json -text
evidence/design-course/sprint-alfred-epic/claude-r5d.initial.json -text
*.md text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.sh text eol=lf

# Windows batch/PowerShell files (none currently in the repo, but if added
# they carry native CRLF semantics).
*.cmd text eol=crlf
*.ps1 text eol=crlf
# Digest-pinned helper: windows-owned-authority-backend.mjs pins the LF blob
# (HELPER_SHA256), so the working copy must stay LF on every host (T11).
plugins/pipeline-core/lib/windows-owned-authority-native.ps1 text eol=lf
# Digest-pinned helper: windows-native-process-observer.mjs pins the LF blob
# (HELPER_SHA256), so the working copy must stay LF on every host.
plugins/pipeline-core/lib/windows-native-process-observer.ps1 text eol=lf

# Binary files: no text conversion.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.woff binary
*.woff2 binary
