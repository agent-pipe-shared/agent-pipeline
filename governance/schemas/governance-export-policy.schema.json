{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-pipeline.dev/schemas/pipeline.governance-export-policy.v1.json",
  "title": "Pipeline governance export policy v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "policyId", "revision", "destinationProfile", "format", "allowedFields"],
  "properties": {
    "schema": { "const": "pipeline.governance-export-policy.v1" },
    "policyId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$" },
    "revision": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "destinationProfile": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$" },
    "format": { "enum": ["cloudevents-json", "otlp-json", "ndjson", "rfc5424"] },
    "allowedFields": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["eventId", "eventType", "occurredAtEpochMs", "eventDigest", "repositoryFingerprint", "correlation", "candidate", "policyDigest"] } }
  }
}
