{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-pipeline.dev/schemas/pipeline.agent-decision-event.v1.json",
  "title": "Pipeline agent decision event v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["eventId", "kind", "state", "reasonCode", "candidateDigest", "relatedHumanDecisionId", "supersedesEventId"],
  "properties": { "eventId": { "type": "string" }, "kind": { "enum": ["assumption", "selection", "verification-scope", "fallback", "escalation"] }, "state": { "enum": ["declared", "verified", "contradicted", "expired", "invalidated", "superseded"] }, "reasonCode": { "type": "string" }, "candidateDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" }, "relatedHumanDecisionId": { "type": ["string", "null"] }, "supersedesEventId": { "type": ["string", "null"] } }
}
