{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-pipeline.dev/schemas/pipeline.effective-organization-policy.v1.json",
  "title": "Pipeline effective organization policy v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "coreVersion", "governanceFloors", "packs", "documentClasses"],
  "properties": {
    "schema": { "const": "pipeline.effective-organization-policy.v1" },
    "coreVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "governanceFloors": { "type": "object", "additionalProperties": false, "required": ["requireHumanDecisionLedger", "allowExternalAuthority"], "properties": { "requireHumanDecisionLedger": { "const": true }, "allowExternalAuthority": { "const": false } } },
    "packs": { "type": "array", "minItems": 1, "maxItems": 32 },
    "documentClasses": { "type": "array", "maxItems": 8 }
  }
}
